+    #[test]
+    fn a_where_token_waiting_at_a_pause_or_the_hold_is_exported_from_that_state_not_with_its_count() {
+        // A where token still waiting when the run pauses or holds is served as every token read while paused or held:
+        // by an export of that state once the state's count is in, and that count's line has no where. At a pause it
+        // comes in the same control file; at the hold it was read while the counts writer was busy, so the last frame
+        // was not counted for it. So it goes whether the pause counts its state for the first time, again (a frame a
+        // token counted, without f) or as the frame thinning skipped that it takes, and for the hold's count. Resuming
+        // forces no frame for it. (Tokens read later, while paused or held: the pause's and the hold's tests above.)
+        let dir = scratch("where-waiting");
+        let spool = dir.join("spool");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(Some(&spool), false, None));
+        let control = dir.join("control");
+        // Pause on `seq` with `tokens` (a where token among them) and resume once the export of `token` is in place:
+        // where.json then.
+        let pause_at = |writer: &mut LiveWriter, model: &Model, seq: u64, tokens: &'static str, token: u64| -> Value {
+            fs::write(&control, format!("{tokens}paused 1\nstep 0\n")).unwrap();
+            let resumer = {
+                let (dir, control) = (dir.clone(), control.clone());
+                std::thread::spawn(move || {
+                    let paused = until(|| {
+                        read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == seq)
+                    });
+                    let exported = until(|| read_json(&dir.join("where.json")).is_some_and(|w| w["token"] == token));
+                    let _ = fs::write(&control, format!("{tokens}paused 0\nstep 0\n"));
+                    (paused, exported)
+                })
+            };
+            assert!(writer.wait(&model.voxels, &model.params));
+            assert_eq!(resumer.join().unwrap(), (true, true), "a paused ack at seq {seq}, the export of token {token}");
+            read_json(&dir.join("where.json")).unwrap()
+        };
+        let place = |w: &Value| (w["token"].as_u64(), w["seq"].as_u64(), w["iter"].as_u64());
+        model.frame(&mut writer, "init", 0);
+        model.step();
+        model.frame(&mut writer, "sampling", 1);
+        writer.drain();
+        // A frame not counted yet: the pause counts it, and exports the box from it.
+        let w = pause_at(&mut writer, &model, 1, "where 1 8.00 8.00 22.00 22.00\n", 1);
+        assert_eq!(place(&w), (Some(1), Some(1), Some(1)));
+        model.step();
+        model.frame(&mut writer, "sampling", 2);
+        writer.drain();
+        assert_eq!(lines(&dir).len(), 2, "resuming forces no frame for the where token served while paused");
+        // A frame a token counted (a request, without f): the pause counts it again, with f, and exports from it.
+        fs::write(&control, "counts 1\nwhere 1 8.00 8.00 22.00 22.00\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "sampling", 3);
+        writer.drain();
+        let w = pause_at(&mut writer, &model, 3, "counts 1\nwhere 2 8.00 8.00 22.00 22.00\n", 2);
+        assert_eq!(place(&w), (Some(2), Some(3), Some(3)));
+        // A frame thinning skipped: the pause takes it (seq 4) and counts it, then exports from it.
+        model.step();
+        model.frame(&mut writer, "sampling", 2_001);
+        assert_eq!((writer.seq, writer.pending.is_some()), (4, true));
+        let w = pause_at(&mut writer, &model, 4, "counts 1\nwhere 3 8.00 8.00 22.00 22.00\n", 3);
+        assert_eq!(place(&w), (Some(3), Some(4), Some(2_001)));
+        // The end of the schedule with a where token waiting: it is read while the count of the token's frame (seq 5)
+        // is kept back on its way to the counts writer, so the last frame (seq 6) is taken but not counted for it. The
+        // hold counts seq 6, durably, then exports the box from it; then finish.
+        let gate = Gate::install(&mut writer);
+        fs::write(&control, "counts 2\nwhere 3 8.00 8.00 22.00 22.00\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        gate.hold();
+        model.frame(&mut writer, "hillclimb", 2_002);
+        assert_eq!(gate.held(), Some((5, Reason::Request)));
+        fs::write(&control, "counts 2\nwhere 4 0.00 0.00 30.00 30.00\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "hillclimb", 2_005);
+        let waiting = writer.counts.as_ref().unwrap().pending();
+        assert_eq!((writer.seq, waiting), (7, true), "seq 6 taken, the where token waiting");
+        gate.release();
+        writer.drain();
+        let finisher = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let held = until(|| dir.join("schedule_done").is_file());
+                let exported = until(|| read_json(&dir.join("where.json")).is_some_and(|w| w["token"] == 4));
+                let _ = fs::write(&control, "counts 2\nwhere 4 0.00 0.00 30.00 30.00\nfinish 1\n");
+                (held, exported)
+            })
+        };
+        assert!(!writer.hold(&model.voxels, &model.params));
+        assert_eq!(finisher.join().unwrap(), (true, true), "schedule_done, the export of token 4");
+        assert_eq!(place(&read_json(&dir.join("where.json")).unwrap()), (Some(4), Some(6), Some(2_005)));
+        writer.sampling_done(&model.voxels, &model.params);
+        // Every count, the pauses' and the hold's included, has no where: no export rode with it.
+        let all = lines(&dir);
+        let seen: Vec<(u64, &str, bool, bool)> = all.iter()
+            .map(|l| (l["seq"].as_u64().unwrap(), l["reason"].as_str().unwrap(), l["has_f"] == json!(true),
+                      l["where"].is_null()))
+            .collect();
+        assert_eq!(seen, [(0, "init", true, true), (1, "pause", true, true), (3, "request", false, true),
+                          (3, "pause", true, true), (4, "pause", true, true), (5, "request", false, true),
+                          (6, "hold", true, true)]);
+        assert_eq!(all[3]["file"], all[2]["file"], "the token's file, replaced");
+        assert_eq!(all[6]["file"], json!("frames/000006.counts.zst"));
+        for token in 1..=4 {
+            assert!(dir.join(format!("where-{token}.bin.zst")).is_file(), "where token {token}");
+        }
+        fs::remove_dir_all(&dir).unwrap();
+    }
