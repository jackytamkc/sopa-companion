+    #[test]
+    fn a_run_that_finishes_where_it_paused_counts_that_state_again_into_frames() {
+        // The app's usual end: a pause, whose count goes to the spool (with f and the start block), then finish at that
+        // same state. The spool is pruned and deleted with the run, so the finish counts the state again into frames/,
+        // and its line is the state's newest. Dense: the pause counts the frame taken last; tiled with the cadence
+        // refusing: the pause takes the frame it skipped, and counts it.
+        for tiled in [false, true] {
+            let dir = scratch(if tiled { "pause-finish-tiled" } else { "pause-finish-dense" });
+            let spool = dir.join("spool");
+            let mut model = Model::new();
+            let mut writer = counted_writer(&dir, tiled, &model, options(Some(&spool), false, Some(5)));
+            model.frame(&mut writer, "init", 0);
+            model.step();
+            if tiled {
+                writer.last_extract_ms = 1e9;
+            }
+            model.frame(&mut writer, "sampling", 1);
+            assert_eq!((writer.seq, writer.pending.is_some()), (if tiled { 1 } else { 2 }, tiled));
+            writer.drain();
+            let control = dir.join("control");
+            fs::write(&control, "paused 1\nstep 0\n").unwrap();
+            let finisher = {
+                let (dir, control) = (dir.clone(), control.clone());
+                std::thread::spawn(move || {
+                    let paused = until(|| read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused"));
+                    let at_pause = lines(&dir);
+                    let _ = fs::write(&control, "paused 1\nstep 0\nfinish 1\n");
+                    (paused, at_pause)
+                })
+            };
+            assert!(!writer.wait(&model.voxels, &model.params));
+            let (paused, at_pause) = finisher.join().unwrap();
+            assert!(paused, "tiled {tiled}: no paused ack");
+            // The pause: the state of seq 1, in the spool, with f and (forced) the start block.
+            assert_eq!(at_pause.len(), 2, "tiled {tiled}: {at_pause:?}");
+            let pause = &at_pause[1];
+            assert_eq!((pause["seq"].as_u64(), pause["reason"].as_str()), (Some(1), Some("pause")));
+            assert_eq!(pause["file"], json!(std::path::absolute(spool.join("000001.counts.zst")).unwrap().to_str().unwrap()));
+            assert_eq!((pause["has_f"].as_bool(), pause["has_start"].as_bool()), (Some(true), Some(true)));
+            let spooled = read_plc1(&line_file(&dir, pause));
+            // The finish: the same state again, in frames/, with f and the start block; written before its ack.
+            let ack = read_json(&dir.join("ack")).unwrap();
+            assert_eq!((ack["state"].as_str(), ack["seq"].as_u64()), (Some("finishing"), Some(1)));
+            let all = lines(&dir);
+            assert_eq!(all.len(), 3, "tiled {tiled}: {all:?}");
+            let finish = &all[2];
+            assert_eq!((finish["seq"].as_u64(), finish["reason"].as_str(), finish["file"].as_str()),
+                       (Some(1), Some("finish"), Some("frames/000001.counts.zst")));
+            assert_eq!((finish["has_f"].as_bool(), finish["has_start"].as_bool(), finish["token"].clone()),
+                       (Some(true), Some(true), Value::Null));
+            let durable = check_counts(&dir, finish, &model);
+            assert_eq!(durable, spooled, "tiled {tiled}: the same snapshot (n, e, f and the start block)");
+            // Finished: no end count; the state's newest line is the durable one.
+            writer.sampling_done(&model.voxels, &model.params);
+            assert_eq!(lines(&dir).len(), 3, "tiled {tiled}: a finished run has no end count");
+            fs::remove_dir_all(&dir).unwrap();
+        }
+    }
