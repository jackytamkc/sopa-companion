+    #[test]
+    fn e_and_the_start_block_average_the_background_split_with_the_frames_parameters() {
+        let dir = scratch("averaged");
+        let mut model = Model::with_empty_strip(600);
+        let (nunfactored, at_init) = model.params.live_test_entries();
+        let mut kinds: Vec<(u32, u8)> = at_init.iter().flatten().map(|&(_, layer, density, _)| (layer, density)).collect();
+        kinds.sort_unstable();
+        kinds.dedup();
+        assert_eq!(kinds, [(0, 0), (0, 1), (1, 0), (1, 1)], "entries in both layers and both density bins");
+        // --live-counts every --live-counts-start 1: the init frame, then frames whose assignment drift has changed.
+        let mut writer = counted_writer(&dir, false, &model, options(None, true, Some(1)));
+        model.frame(&mut writer, "init", 0);
+        for iteration in 1..=4 {
+            model.step();
+            model.frame(&mut writer, "sampling", iteration);
+        }
+        writer.drain();
+        let last = lines(&dir).pop().unwrap();
+        assert_eq!(last["seq"], json!(4));
+        let file = check_counts(&dir, &last, &model);
+        let (_, now) = model.params.live_test_entries();
+        let λ_bg = model.params.λ_bg.clone();
+        let own = |g: usize, layer: usize, density: usize| λ_bg[[g, layer, density]] as f64;
+        let e = averaged(&model.params, nunfactored, &now, own, |_| false);
+        matches(&file.indptr, &file.genes, &file.e, &e).unwrap();
+        // The background is large enough here to tell the split's own p from a wrong one: half of each entry's
+        // background, or layer 0's for both layers, would move e by more than its rounding.
+        let half = averaged(&model.params, nunfactored, &now, |g, l, d| 0.5 * own(g, l, d), |_| false);
+        let layer0 = averaged(&model.params, nunfactored, &now, |g, _, d| own(g, 0, d), |_| false);
+        assert!(matches(&file.indptr, &file.genes, &file.e, &half).is_err());
+        assert!(matches(&file.indptr, &file.genes, &file.e, &layer0).is_err());
+        let (sum_n, sum_e) = (file.n.iter().map(|&n| n as f64).sum::<f64>(), file.e.iter().map(|&e| e as f64 / 32.0).sum::<f64>());
+        assert!(sum_e < 0.95 * sum_n, "a background share that matters (about 8 %): e {sum_e} of n {sum_n}");
+
+        // The start block: the init frame's assignment (its pattern), with this frame's parameters.
+        let start = averaged(&model.params, nunfactored, &at_init, own, |_| false);
+        let (start_indptr, start_genes) = pattern(&start);
+        let first = read_plc1(&dir.join("frames/000000.counts.zst"));
+        assert_eq!((&start_indptr, &start_genes), (&first.indptr, &first.genes), "the init frame's pattern");
+        matches(&start_indptr, &start_genes, file.start.as_ref().unwrap(), &start).unwrap();
+        // Drift moved transcripts: on the cells it changed, the start block is not the frame's own e.
+        let per_gene = |row: &Vec<(u32, u32, u8, u32)>| {
+            let mut n: Vec<(u32, u32)> = Vec::new();
+            for &(g, _, _, count) in row {
+                match n.last_mut() {
+                    Some((gene, sum)) if *gene == g => *sum += count,
+                    _ => n.push((g, count)),
+                }
+            }
+            n
+        };
+        let changed: Vec<usize> = (0..at_init.len()).filter(|&c| per_gene(&at_init[c]) != per_gene(&now[c])).collect();
+        assert!(!changed.is_empty(), "drift changed the assignment");
+        for &c in &changed {
+            let stored = |indptr: &[u32], genes: &[u32], values: &[u16]| -> Vec<(u32, u16)> {
+                (indptr[c] as usize..indptr[c + 1] as usize).map(|k| (genes[k], values[k])).collect()
+            };
+            assert_ne!(stored(&start_indptr, &start_genes, file.start.as_ref().unwrap()),
+                       stored(&file.indptr, &file.genes, &file.e), "cell {c}");
+        }
+        writer.sampling_done(&model.voxels, &model.params);
+
+        // A frozen cell under unmodeled_fixed_cells keeps every transcript (p = 1: e = n on its row); without the
+        // option, its count is split as any other's.
+        model.params.frozen_cells[4] = true;
+        let fixed = model.params.live_gene_counts(false, true, None);
+        let free = model.params.live_gene_counts(false, false, None);
+        model.params.frozen_cells[4] = false;
+        matches(&fixed.indptr, &fixed.genes, &fixed.e, &averaged(&model.params, nunfactored, &now, own, |c| c == 4)).unwrap();
+        matches(&free.indptr, &free.genes, &free.e, &e).unwrap();
+        let row = fixed.indptr[4] as usize..fixed.indptr[5] as usize;
+        assert!(!row.is_empty() && row.clone().all(|k| fixed.e[k] as u32 == 32 * fixed.n[k] as u32));
+        assert!(row.clone().any(|k| free.e[k] < fixed.e[k]));
+
+        // Beyond u16: e above 2,047.97 is clipped while n is not; n above 65,535 is clipped with its e. Each clipped
+        // value is counted in `saturated`.
+        model.params.live_test_assign(0, 0, 0, 0, 10_000);
+        model.params.live_test_assign(1, 1, 0, 0, 70_000);
+        let (_, big) = model.params.live_test_entries();
+        let expected = averaged(&model.params, nunfactored, &big, own, |_| false);
+        let clipped = model.params.live_gene_counts(false, false, None);
+        let at = |c: usize, gene: u32| (clipped.indptr[c]..clipped.indptr[c + 1]).find(|&k| clipped.genes[k as usize] == gene).unwrap() as usize;
+        let (k0, k1) = (at(0, 0), at(1, 1));
+        assert!(clipped.n[k0] < u16::MAX && expected[0].iter().any(|&(g, e)| g == 0 && 32.0 * e > 65_535.5));
+        assert_eq!((clipped.e[k0], clipped.n[k1], clipped.e[k1]), (u16::MAX, u16::MAX, u16::MAX));
+        assert_eq!(clipped.saturated, 3);
+        fs::remove_dir_all(&dir).unwrap();
+    }
