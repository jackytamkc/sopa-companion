+    #[test]
+    fn every_mode_adds_no_count_at_a_pause_on_a_frame_every_or_a_token_counted() {
+        // In every mode each count has f, a token's too: a pause on a frame counted for every, or for a token, has the
+        // count proseg saves there already and adds no line, before its ack or while paused. Without a spool that count
+        // is durable, so the end adds none either; with one, the end counts the state again into frames/, once.
+        for spooled in [false, true] {
+            let dir = scratch(if spooled { "every-pause-spool" } else { "every-pause" });
+            let spool = dir.join("spool");
+            let mut model = Model::new();
+            let mut writer = counted_writer(&dir, false, &model, options(spooled.then_some(spool.as_path()), true, Some(3)));
+            let control = dir.join("control");
+            // Pause at the committed state `seq`, the control file keeping `tokens`, and resume after 400 ms (ten more
+            // paused reads): how many lines there are at the paused ack, and before resuming.
+            let pause_at = |writer: &mut LiveWriter, model: &Model, seq: u64, tokens: &'static str| -> (usize, usize) {
+                fs::write(&control, format!("{tokens}paused 1\nstep 0\n")).unwrap();
+                let resumer = {
+                    let (dir, control) = (dir.clone(), control.clone());
+                    std::thread::spawn(move || {
+                        let paused = until(|| {
+                            read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == seq)
+                        });
+                        let at_ack = lines(&dir).len();
+                        sleep(Duration::from_millis(400));
+                        let later = lines(&dir).len();
+                        let _ = fs::write(&control, format!("{tokens}paused 0\nstep 0\n"));
+                        (paused, at_ack, later)
+                    })
+                };
+                assert!(writer.wait(&model.voxels, &model.params));
+                let (paused, at_ack, later) = resumer.join().unwrap();
+                assert!(paused, "spooled {spooled}: no paused ack at seq {seq}");
+                (at_ack, later)
+            };
+            model.frame(&mut writer, "init", 0);
+            model.step();
+            model.frame(&mut writer, "sampling", 1);
+            writer.drain();
+            // A pause on a frame counted for every.
+            assert_eq!(pause_at(&mut writer, &model, 1, ""), (2, 2), "spooled {spooled}: the pause on seq 1 adds no line");
+            // A token read while running: the next frame is counted for it (the counts writer is idle), with f.
+            fs::write(&control, "counts 1\n").unwrap();
+            assert!(writer.wait(&model.voxels, &model.params));
+            model.step();
+            model.frame(&mut writer, "sampling", 2);
+            writer.drain();
+            // A pause on the token's frame.
+            assert_eq!(pause_at(&mut writer, &model, 2, "counts 1\n"), (3, 3),
+                       "spooled {spooled}: the pause on seq 2 adds no line");
+            writer.sampling_done(&model.voxels, &model.params);
+            let all = lines(&dir);
+            let seen: Vec<(u64, &str, bool, bool)> = all.iter()
+                .map(|l| (l["seq"].as_u64().unwrap(), l["reason"].as_str().unwrap(), l["has_f"] == json!(true),
+                          l["has_start"] == json!(true)))
+                .collect();
+            let mut expected = vec![(0, "init", true, true), (1, "every", true, false), (2, "request", true, true)];
+            if spooled {
+                expected.push((2, "end", true, true));
+            }
+            assert_eq!(seen, expected, "spooled {spooled}");
+            assert_eq!(all[2]["token"], json!(1));
+            for seq in 1..=2 {
+                let file = format!("{seq:06}.counts.zst");
+                let name = if spooled {
+                    std::path::absolute(spool.join(&file)).unwrap().to_str().unwrap().to_owned()
+                } else {
+                    format!("frames/{file}")
+                };
+                assert_eq!(all[seq]["file"], json!(name), "spooled {spooled}");
+            }
+            let token = check_counts(&dir, &all[2], &model);
+            if spooled {
+                assert_eq!(all[3]["file"], json!("frames/000002.counts.zst"));
+                let end = check_counts(&dir, &all[3], &model);
+                assert_eq!((&end.genes, &end.n, &end.e, &end.f), (&token.genes, &token.n, &token.e, &token.f),
+                           "the same snapshot");
+            }
+            fs::remove_dir_all(&dir).unwrap();
+        }
+    }
