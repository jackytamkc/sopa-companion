+    use crate::sampler::ModelPriors;
+    use crate::sampler::paramsampler::ParamSampler;
+    use crate::sampler::runvec::RunVec;
+    use crate::sampler::transcriptrepo::TranscriptRepo;
+    use crate::sampler::transcripts::{BACKGROUND_CELL, PriorTranscriptSeg, Transcript};
+    use crate::sampler::voxelcheckerboard::{Voxel, VoxelCountKey, VoxelOffset};
+
+    /// A small real model: nine 10 µm square cells on a 30 x 30 µm field (2 µm voxels, two layers, 10 µm quads), eight
+    /// genes (three unfactored), 1,800 transcripts, 15 % of them outside every nucleus; initialised as main.rs does.
+    struct Model {
+        voxels: VoxelCheckerboard,
+        params: ModelParams,
+        priors: ModelPriors,
+        sampler: ParamSampler,
+        repo: TranscriptRepo,
+    }
+
+    const NTRANSCRIPTS: usize = 1800;
+
+    impl Model {
+        fn new() -> Model {
+            Model::with_empty_strip(0)
+        }
+
+        /// The model with `extra` more transcripts, of every gene, in a strip of tissue without cells beside the field
+        /// (x 30-40 µm): the background model then takes a share of the cells' transcripts that matters.
+        fn with_empty_strip(extra: usize) -> Model {
+            let mut transcripts = RunVec::new();
+            let mut priorseg = RunVec::new();
+            let mut fovs = RunVec::new();
+            let mut state = 0x5EED_u64;
+            let mut uniform = move || {
+                state = state.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+                (state >> 40) as f32 / (1u64 << 24) as f32
+            };
+            for t in 0..NTRANSCRIPTS {
+                let (x, y, z) = (uniform() * 30.0, uniform() * 30.0, uniform() * 10.0);
+                let cell = (x / 10.0).min(2.0) as u32 + 3 * (y / 10.0).min(2.0) as u32;
+                let gene = if uniform() < 0.5 { cell % 8 } else { (t % 8) as u32 };
+                let prior = if uniform() < 0.85 { cell } else { BACKGROUND_CELL };
+                transcripts.push(Transcript { x, y, z, qv: 40.0, gene });
+                priorseg.push(PriorTranscriptSeg { nucleus: prior, cell: prior });
+                fovs.push(0);
+            }
+            for t in 0..extra {
+                let (x, y, z) = (30.0 + uniform() * 10.0, uniform() * 30.0, uniform() * 10.0);
+                transcripts.push(Transcript { x, y, z, qv: 40.0, gene: (t % 8) as u32 });
+                priorseg.push(PriorTranscriptSeg { nucleus: BACKGROUND_CELL, cell: BACKGROUND_CELL });
+                fovs.push(0);
+            }
+            let mut dataset = TranscriptDataset {
+                transcripts,
+                transcript_ids: None,
+                priorseg,
+                fovs,
+                barcode_positions: None,
+                gene_names: (0..8).map(|g| format!("G{g}")).collect(),
+                fov_names: vec!["fov".into()],
+                original_cell_ids: (0..9).map(|c| format!("cell-{c}")).collect(),
+                ncells: 9,
+            };
+            dataset.normalize_z_coordinates();
+            let voxels = VoxelCheckerboard::from_prior_transcript_assignments(&dataset, 2.0, 10.0, 2, 0.8, 0.5, 0, 0.5, 2);
+            let priors = ModelPriors {
+                dispersion: None,
+                burnin_dispersion: Some(1.0),
+                use_cell_scales: false,
+                unmodeled_fixed_cells: false,
+                prior_weight: 1.0,
+                μ_μ_volume: (50.0_f32).ln(),
+                σ_μ_volume: 3.0,
+                α_σ_volume: 4.0,
+                β_σ_volume: 1.0,
+                use_factorization: true,
+                enforce_connectivity: false,
+                αθ: 1e-1,
+                eφ: 1.0,
+                fφ: 1.0,
+                μφ: -1.0,
+                τφ: 0.1,
+                α_bg: 1.0,
+                β_bg: 1.0,
+                σ_iiq: 0.04,
+                use_diffusion_model: true,
+                p_diffusion: 0.2,
+                σ_xy_diffusion_near: 1.0,
+                σ_xy_diffusion_far: 4.0,
+                σ_z_diffusion: 0.1,
+                σ_xy_diffusion_proposal: 4.0,
+                σ_z_diffusion_proposal: 0.2,
+                τv: 10.0,
+            };
+            let mut params = ModelParams::new(&voxels, &priors, 3, 3, 2, 2);
+            let sampler = ParamSampler::new();
+            for _ in 0..20 {
+                sampler.sample(&priors, &mut params, true, 1.0, false, false, false);
+            }
+            let repo = TranscriptRepo::new(&priors, voxels.voxelsize, voxels.voxelsize_z);
+            Model { voxels, params, priors, sampler, repo }
+        }
+
+        /// One sampler iteration without morphology: drift, then the parameters (run_sampler after burn-in).
+        fn step(&mut self) {
+            self.repo.sample(&mut self.voxels, &self.priors, &mut self.params, 1.0, false);
+            self.sampler.sample(&self.priors, &mut self.params, false, 1.0, false, true, true);
+        }
+
+        fn frame(&self, writer: &mut LiveWriter, phase: &str, iteration: usize) {
+            let ncells = self.voxels.ncells;
+            writer.frame(&self.voxels, &self.params, phase, iteration, 1.0, &IterationStats::default(), ncells);
+        }
+    }
+
+    fn scratch(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("proseg-live-counts-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    fn options(spool: Option<&Path>, every: bool, start_every: Option<u64>) -> CountsOptions {
+        CountsOptions { every, spool: spool.map(Path::to_path_buf), start_every, unmodeled_fixed_cells: false }
+    }
+
+    /// A writer with --live-counts, as main.rs makes it.
+    fn counted_writer(dir: &Path, tiled: bool, model: &Model, options: CountsOptions) -> LiveWriter {
+        let control = dir.join("control");
+        let mut writer = LiveWriter::new(dir.to_str().unwrap(), control.to_str(), NTRANSCRIPTS, model.voxels.ncells, tiled);
+        writer.values.insert("diffusion-sigma-far".into(), json!(model.priors.σ_xy_diffusion_far));
+        writer.enable_counts(options);
+        writer
+    }
+
+    fn lines(dir: &Path) -> Vec<Value> {
+        fs::read_to_string(dir.join("counts.jsonl"))
+            .unwrap_or_default()
+            .lines()
+            .map(|line| serde_json::from_str(line).unwrap())
+            .collect()
+    }
+
+    fn read_json(path: &Path) -> Option<Value> {
+        serde_json::from_slice(&fs::read(path).ok()?).ok()
+    }
+
+    /// A counts line's file, wherever it was written.
+    fn line_file(dir: &Path, line: &Value) -> PathBuf {
+        dir.join(line["file"].as_str().unwrap())
+    }
+
+    struct Cursor<'a> {
+        bytes: &'a [u8],
+        at: usize,
+    }
+
+    impl<'a> Cursor<'a> {
+        fn take(&mut self, n: usize) -> &'a [u8] {
+            let slice = &self.bytes[self.at..self.at + n];
+            self.at += n;
+            slice
+        }
+        fn u32(&mut self) -> u32 {
+            u32::from_le_bytes(self.take(4).try_into().unwrap())
+        }
+        fn u32s(&mut self, n: usize) -> Vec<u32> {
+            self.take(4 * n).chunks(4).map(|c| u32::from_le_bytes(c.try_into().unwrap())).collect()
+        }
+        fn u16s(&mut self, n: usize) -> Vec<u16> {
+            self.take(2 * n).chunks(2).map(|c| u16::from_le_bytes(c.try_into().unwrap())).collect()
+        }
+    }
+
+    /// A PLC1 file read back field by field (independently of `plc1`), genes made absolute again.
+    #[derive(Debug, PartialEq)]
+    struct Plc1 {
+        ncells: usize,
+        ngenes: usize,
+        iteration: u32,
+        saturated: u32,
+        flags: u32,
+        indptr: Vec<u32>,
+        genes: Vec<u32>,
+        n: Vec<u16>,
+        e: Vec<u16>,
+        f: Option<Vec<u16>>,
+        start: Option<Vec<u16>>,
+    }
+
+    fn read_plc1(path: &Path) -> Plc1 {
+        let raw = zstd::bulk::decompress(&fs::read(path).unwrap(), 1 << 30).unwrap();
+        let mut at = Cursor { bytes: &raw, at: 0 };
+        assert_eq!(at.take(4), b"PLC1");
+        assert_eq!(at.u32(), 1, "version");
+        let (ncells, ngenes, nnz, flags) = (at.u32() as usize, at.u32() as usize, at.u32() as usize, at.u32());
+        assert_eq!(flags & !7, 0, "unknown flag bits");
+        assert_eq!(flags & 2 != 0, ngenes > 65_535, "genes as u32 iff ngenes > 65,535");
+        assert_eq!(at.u32(), 32, "e_scale");
+        let (iteration, saturated) = (at.u32(), at.u32());
+        let indptr = at.u32s(ncells + 1);
+        assert_eq!((indptr[0], indptr[ncells] as usize), (0, nnz));
+        let steps = if flags & 2 != 0 { at.u32s(nnz) } else { at.u16s(nnz).into_iter().map(u32::from).collect() };
+        let mut genes = Vec::with_capacity(nnz);
+        for row in indptr.windows(2) {
+            assert!(row[0] <= row[1]);
+            let mut gene = 0;
+            for (k, &step) in steps[row[0] as usize..row[1] as usize].iter().enumerate() {
+                assert!(k == 0 || step > 0, "genes ascend within a row");
+                gene = if k == 0 { step } else { gene + step };
+                assert!((gene as usize) < ngenes);
+                genes.push(gene);
+            }
+        }
+        let (n, e) = (at.u16s(nnz), at.u16s(nnz));
+        let f = (flags & 1 != 0).then(|| at.u16s(nnz));
+        let start = (flags & 4 != 0).then(|| {
+            let start_nnz = at.u32() as usize;
+            at.u16s(start_nnz)
+        });
+        assert_eq!(at.at, raw.len(), "no trailing bytes");
+        Plc1 { ncells, ngenes, iteration, saturated, flags, indptr, genes, n, e, f, start }
+    }
+
+    fn read_counted(path: &Path) -> Vec<f32> {
+        let raw = zstd::bulk::decompress(&fs::read(path).unwrap(), 1 << 30).unwrap();
+        raw.chunks(4).map(|c| f32::from_le_bytes(c.try_into().unwrap())).collect()
+    }
+
+    /// A count file against the model state it was taken from, and its sidecar: n is `counts` per gene (row sums: the
+    /// assigned totals of cells.zst), f `foreground_counts` (row sums: the non-background totals), f <= n, e <= n; the
+    /// sidecar holds each row's stored e / 32.
+    fn check_counts(dir: &Path, line: &Value, model: &Model) -> Plc1 {
+        let file = read_plc1(&line_file(dir, line));
+        let (assigned, foreground) = model.params.live_cell_counts();
+        assert_eq!((file.ncells, file.ngenes), (model.voxels.ncells, 8));
+        assert_eq!(line["iter"].as_u64().unwrap(), file.iteration as u64);
+        let counted = read_counted(&dir.join(line["counted_file"].as_str().unwrap()));
+        assert_eq!(counted.len(), file.ncells);
+        for c in 0..file.ncells {
+            let row = file.indptr[c] as usize..file.indptr[c + 1] as usize;
+            assert_eq!(file.n[row.clone()].iter().map(|&v| v as u32).sum::<u32>(), assigned[c], "cell {c} n");
+            if let Some(f) = &file.f {
+                assert_eq!(f[row.clone()].iter().map(|&v| v as u32).sum::<u32>(), foreground[c], "cell {c} f");
+                assert!(row.clone().all(|k| f[k] <= file.n[k]), "f <= n");
+            }
+            assert!(row.clone().all(|k| file.e[k] as u32 <= 32 * file.n[k] as u32 && file.n[k] > 0), "0 < n, e <= n");
+            let sum: u64 = file.e[row].iter().map(|&e| e as u64).sum();
+            assert_eq!(counted[c], (sum as f64 / 32.0) as f32, "sidecar of cell {c}");
+        }
+        let sum16 = |values: &[u16]| values.iter().map(|&v| v as u64).sum::<u64>();
+        assert_eq!(line["nnz"].as_u64().unwrap() as usize, file.genes.len());
+        assert_eq!(line["sum_n"].as_u64().unwrap(), sum16(&file.n));
+        assert_eq!(line["sum_e"].as_f64().unwrap(), sum16(&file.e) as f64 / 32.0);
+        assert_eq!(line["sum_f"].as_u64(), file.f.as_deref().map(sum16));
+        assert_eq!((line["has_f"].as_bool(), line["has_start"].as_bool()), (Some(file.f.is_some()), Some(file.start.is_some())));
+        assert_eq!(line["saturated"].as_u64().unwrap(), file.saturated as u64);
+        assert_eq!(line["bytes"].as_u64().unwrap(), fs::metadata(line_file(dir, line)).unwrap().len());
+        file
+    }
+
+    /// Poll until `ready` holds (or 30 s): the watcher threads below never hang a test.
+    fn until(ready: impl FnMut() -> bool) -> bool {
+        seen(Duration::from_secs(30), ready)
+    }
+
+    /// Whether `ready` holds at some point within `time` (polled every 5 ms).
+    fn seen(time: Duration, mut ready: impl FnMut() -> bool) -> bool {
+        let deadline = Instant::now() + time;
+        loop {
+            if ready() {
+                return true;
+            }
+            if Instant::now() >= deadline {
+                return false;
+            }
+            sleep(Duration::from_millis(5));
+        }
+    }
+
+    /// The test's hand on the counts writer: installed in place of its queue, a relay thread passes every job on to it at
+    /// once, except the next one after `hold`, which waits for `release` (30 s at most, so a failing test never hangs).
+    /// A test thus sees what proseg does while a state's counts line is unwritten, whatever the writer's speed.
+    struct Gate {
+        holding: Arc<std::sync::atomic::AtomicBool>,
+        held: std::sync::mpsc::Receiver<(u64, Reason)>,
+        release: std::sync::mpsc::Sender<()>,
+    }
+
+    impl Gate {
+        fn install(writer: &mut LiveWriter) -> Gate {
+            let (sender, jobs) = sync_channel::<CountsJob>(1);
+            let real = writer.counts.as_mut().unwrap().sender.replace(sender).unwrap();
+            let holding = Arc::new(std::sync::atomic::AtomicBool::new(false));
+            let (tell, held) = std::sync::mpsc::channel();
+            let (release, released) = std::sync::mpsc::channel();
+            let hold = holding.clone();
+            std::thread::spawn(move || {
+                for job in jobs {
+                    if hold.swap(false, Ordering::AcqRel) {
+                        let _ = tell.send((job.seq, job.reason));
+                        let _ = released.recv_timeout(Duration::from_secs(30));
+                    }
+                    if real.send(job).is_err() {
+                        break;
+                    }
+                }
+            });
+            Gate { holding, held, release }
+        }
+
+        /// Keep the next job back.
+        fn hold(&self) {
+            self.holding.store(true, Ordering::Release);
+        }
+
+        /// The seq and reason of the job kept back, once the main thread has queued it (None after 30 s).
+        fn held(&self) -> Option<(u64, Reason)> {
+            self.held.recv_timeout(Duration::from_secs(30)).ok()
+        }
+
+        /// Pass the job kept back on to the counts writer.
+        fn release(&self) {
+            let _ = self.release.send(());
+        }
+    }
+
+    #[test]
+    fn counts_and_where_lines_are_parsed() {
+        let dir = scratch("tokens");
+        let control = dir.join("control");
+        let mut writer = LiveWriter::new(dir.to_str().unwrap(), control.to_str(), 1, 1, false);
+        fs::write(&control, "paused 1\ncounts 7\nwhere 8 10.00 20.00 110.50 120.25\n").unwrap();
+        let parsed = writer.read_control();
+        assert!(parsed.paused);
+        assert_eq!(parsed.counts, 7);
+        assert_eq!(parsed.where_, Some(WhereAsk { token: 8, bx: [10.0, 20.0, 110.5, 120.25] }));
+        // Malformed lines are no tokens.
+        for line in ["counts 0", "counts x", "counts -1", "counts 1.5", "counts", "where 0 1 2 3 4", "where 8 1 2 3",
+                     "where 8 1 2 3 4 5", "where 8 1 2 nan 4", "where 8 1 2 inf 4", "where 8 3 2 1 4", "where 8 1 4 3 2",
+                     "where 8 1 2 1 4", "where x 1 2 3 4", "where -8 1 2 3 4", "where 8 a 2 3 4", "where"] {
+            fs::write(&control, format!("paused 0\n{line}\n")).unwrap();
+            let parsed = writer.read_control();
+            assert_eq!((parsed.counts, parsed.where_), (0, None), "{line:?}");
+        }
+        // A malformed line never undoes a good one (the engine writes one of each).
+        fs::write(&control, "counts 7\ncounts 0\ncounts x\nwhere 8 1 2 3 4\nwhere 9 1 2\nwhere 0 1 2 3 4\n").unwrap();
+        let parsed = writer.read_control();
+        assert_eq!((parsed.counts, parsed.where_.map(|w| w.token)), (7, Some(8)));
+        // A control file that cannot be read keeps its tokens with the rest.
+        fs::remove_file(&control).unwrap();
+        assert_eq!(writer.read_control().counts, 7);
+        drop(writer);
+        fs::remove_dir_all(&dir).unwrap();
+    }
