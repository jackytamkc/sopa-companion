+        assert_eq!(args.live_counts.as_deref(), Some("request"));
+        assert_eq!((args.live_counts_dir.as_deref(), args.live_counts_start), (Some("spool"), Some(1)));
+        let args = parse(&["--live-counts", "every", "--live-counts-start", "4", "--live-tiled"]).unwrap();
+        assert_eq!((args.live_counts.as_deref(), args.live_counts_start, args.live_tiled), (Some("every"), Some(4), true));
+        let args = parse(&["--live-counts-start", "--live-counts", "request"]).unwrap();
+        assert_eq!(args.live_counts_start, Some(1));
+        for bad in [
+            &["--live-counts", "sometimes"][..],
+            &["--live-counts"],
+            &["--live-counts-dir", "spool"],
+            &["--live-counts-start", "2"],
+            &["--live-counts", "request", "--live-counts-start", "0"],
+            &["--live-counts", "request", "--live-counts-start", "-1"],
+            &["--live-counts", "request", "--live-counts-start", "x"],
+        ] {
+            assert!(parse(bad).is_err(), "{bad:?}");
+        }
+        assert!(Args::try_parse_from(["proseg-live", "t.parquet", "--live-counts", "request"]).is_err());
+        // The engine's capability check reads --help.
+        assert!(Args::command().render_long_help().to_string().contains("--live-counts"));
+    }
 }
