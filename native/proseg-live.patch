+        let gate = Gate::install(&mut writer);
+        gate.hold();
+        let control = dir.join("control");
+        fs::write(&control, "paused 1\nstep 0\n").unwrap();
+        let watcher = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let mut problems: Vec<String> = Vec::new();
+                let held = gate.held();
+                if held != Some((1, Reason::Pause)) {
+                    problems.push(format!("kept back {held:?}, not the pause's count of seq 1"));
+                }
+                let acked = || read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused");
+                if seen(Duration::from_millis(300), acked) || lines(&dir).len() != 1 {
+                    problems.push(format!("while the pause's count was unwritten: ack {:?}, lines {:?}",
+                                          read_json(&dir.join("ack")), lines(&dir)));
+                }
+                gate.release();
+                // The paused ack: the state's counts line is in counts.jsonl already.
+                let mut ack = Value::Null;
+                if !until(|| {
+                    ack = read_json(&dir.join("ack")).unwrap_or(Value::Null);
+                    ack["state"] == "paused"
+                }) {
+                    problems.push("no paused ack".into());
+                }
+                let at_ack = lines(&dir);
+                if ack["seq"] != json!(1) || at_ack.len() != 2 || at_ack[1]["seq"] != json!(1)
+                    || at_ack[1]["reason"] != "pause" || at_ack[1]["has_f"] != json!(true) {
+                    problems.push(format!("at the paused ack {ack}: lines {at_ack:?}"));
+                }
+                // Tokens while paused: the counts token is served without a line, the where export at once.
+                let _ = fs::write(&control, "paused 1\nstep 0\ncounts 5\nwhere 6 8.00 8.00 22.00 22.00\n");
+                if !until(|| read_json(&dir.join("where.json")).is_some_and(|w| w["token"] == 6)) {
+                    problems.push("no where export while paused".into());
+                }
+                // Ten more paused reads: the state is never counted again.
+                sleep(Duration::from_millis(400));
+                let later = lines(&dir);
+                if later.len() != 2 {
+                    problems.push(format!("counted again while paused: {later:?}"));
+                }
+                let _ = fs::write(&control, "paused 0\nstep 0\ncounts 5\nwhere 6 8.00 8.00 22.00 22.00\n");
+                (problems, gate)
+            })
+        };
+        assert!(writer.wait(&model.voxels, &model.params));
+        let (problems, gate) = watcher.join().unwrap();
+        assert!(problems.is_empty(), "{problems:?}");
+        let paused = &lines(&dir)[1];
+        assert_eq!(paused["file"], json!(std::path::absolute(spool.join("000001.counts.zst")).unwrap().to_str().unwrap()));
+        assert_eq!(paused["token"], Value::Null);
+        check_counts(&dir, paused, &model);
+        let w = read_json(&dir.join("where.json")).unwrap();
+        assert_eq!((w["seq"].as_u64(), w["iter"].as_u64(), w["file"].as_str()), (Some(1), Some(1), Some("where-6.bin.zst")));
+        assert!(w["entries"].as_u64().unwrap() > 0 && dir.join("where-6.bin.zst").is_file());
+
+        // Resuming forces no frame for the tokens read while paused.
+        model.step();
+        model.frame(&mut writer, "sampling", 2);
+        writer.drain();
+        assert_eq!(lines(&dir).len(), 2);
+        // A new token does.
+        fs::write(&control, "paused 0\nstep 0\ncounts 6\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "sampling", 3);
+        writer.drain();
+        let all = lines(&dir);
+        assert_eq!((all.len(), all[2]["token"].as_u64(), all[2]["reason"].as_str()), (3, Some(6), Some("request")));
+        // Read now: a pause there counts the state again into this same file.
+        let request = read_plc1(&line_file(&dir, &all[2]));
+        assert!(request.f.is_none());
+
+        // A pause at a state its request counted (in the spool, without f) counts that state again there, with f,
+        // before the paused ack; finishing from that pause counts it again, durably, before the finishing ack. (A
+        // pause's own count in the spool: the next test.)
+        fs::write(&control, "paused 1\nstep 0\n").unwrap();
+        let finisher = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let mut problems: Vec<String> = Vec::new();
+                if !until(|| read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == 3)) {
+                    problems.push("no paused ack at seq 3".into());
+                }
+                let at_ack = lines(&dir);
+                if at_ack.len() != 4 || at_ack[3]["seq"] != json!(3) || at_ack[3]["reason"] != "pause"
+                    || at_ack[3]["file"] != at_ack[2]["file"] || at_ack[3]["has_f"] != json!(true) {
+                    problems.push(format!("at the paused ack: lines {at_ack:?}"));
+                }
+                gate.hold();
+                let _ = fs::write(&control, "paused 1\nstep 0\nfinish 1\n");
+                let held = gate.held();
+                if held != Some((3, Reason::Finish)) {
+                    problems.push(format!("kept back {held:?}, not the finish's count of seq 3"));
+                }
+                let finishing = || read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "finishing");
+                if seen(Duration::from_millis(300), finishing) || lines(&dir).len() != 4 {
+                    problems.push(format!("while the finish's count was unwritten: ack {:?}, lines {:?}",
+                                          read_json(&dir.join("ack")), lines(&dir)));
+                }
+                gate.release();
+                if !until(finishing) || lines(&dir).last().is_none_or(|l| l["reason"] != "finish") {
+                    problems.push(format!("at the finishing ack: lines {:?}", lines(&dir)));
+                }
+                problems
+            })
+        };
+        // The state at seq 3 was counted on request: the pause counts it again with f, the finish counts it durably.
+        assert!(!writer.wait(&model.voxels, &model.params));
+        let problems = finisher.join().unwrap();
+        assert!(problems.is_empty(), "{problems:?}");
+        let ack = read_json(&dir.join("ack")).unwrap();
+        assert_eq!((ack["state"].as_str(), ack["seq"].as_u64()), (Some("finishing"), Some(3)));
+        let all = lines(&dir);
+        assert_eq!(all.len(), 5);
+        assert_eq!((all[3]["seq"].as_u64(), all[3]["reason"].as_str(), all[3]["token"].clone()),
+                   (Some(3), Some("pause"), Value::Null));
+        assert_eq!(all[3]["file"], all[2]["file"], "the request's file, replaced");
+        assert_eq!((all[4]["seq"].as_u64(), all[4]["reason"].as_str(), all[4]["file"].as_str()),
