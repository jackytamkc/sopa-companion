+    #[test]
+    fn a_request_never_waits_for_a_busy_counts_writer() {
+        let dir = scratch("busy");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(None, false, None));
+        model.frame(&mut writer, "init", 0);
+        writer.drain();
+        // The counts queue is full (a job no writer takes), while the writer looks idle: the request frame is taken
+        // (its snapshot extracted) but try_send gives the counts back, and the tokens stay pending.
+        let (sender, receiver) = sync_channel::<CountsJob>(1);
+        let empty = LiveGeneCounts {
+            indptr: vec![0],
+            genes: vec![],
+            n: vec![],
+            e: vec![],
+            f: None,
+            start: None,
+            saturated: 0,
+            f_outside: 0,
+        };
+        sender
+            .send(CountsJob {
+                seq: 0, iteration: 0, reason: Reason::Request, token: None, ncells: 0, ngenes: 1, counts: empty,
+                path: dir.join("unused"), name: "unused".into(), place: None, extract_ms: 0.0,
+            })
+            .unwrap();
+        let real = writer.counts.as_mut().unwrap().sender.replace(sender);
+        fs::write(dir.join("control"), "counts 1\nwhere 1 0 0 10 10\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        // The frame returns at once (5 s at most): a request that waited for the full queue would wait forever, so the
+        // queue is then dropped (the waiting frame gives up) and the test fails instead of hanging.
+        let mut queue = Some(receiver);
+        std::thread::scope(|scope| {
+            let (returned, waited) = std::sync::mpsc::channel();
+            let (model, writer) = (&model, &mut writer);
+            scope.spawn(move || {
+                model.frame(writer, "sampling", 1);
+                let _ = returned.send(());
+            });
+            if waited.recv_timeout(Duration::from_secs(5)).is_err() {
+                drop(queue.take());
+                panic!("a request frame waited for the busy counts writer");
+            }
+        });
+        assert_eq!(writer.seq, 2, "the frame itself is taken");
+        let counts = writer.counts.as_ref().unwrap();
+        assert_eq!((counts.served, counts.served_where, counts.last.map(|l| l.seq)), (0, 0, Some(0)));
+        assert!(counts.pending());
+        // While a counts job is in flight the writer is busy: a pending token asks for no frame at all (the frame
+        // follows thinning and the cadence as without --live-counts).
+        writer.counts.as_mut().unwrap().sender = real;
+        writer.counts.as_mut().unwrap().queued += 1;
+        assert_eq!(writer.counts_ask("sampling"), None);
+        model.step();
+        model.frame(&mut writer, "sampling", 2_001);
+        assert_eq!(writer.seq, 2, "thinned as usual, the token still pending");
+        assert!(writer.pending.is_some());
+        writer.counts.as_mut().unwrap().queued -= 1;
+        assert_eq!(writer.counts_ask("sampling"), Some(Reason::Request));
+        drop(queue);
+        writer.drain();
+        fs::remove_dir_all(&dir).unwrap();
+    }
