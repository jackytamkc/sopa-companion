+    use super::*;
+
+    #[test]
+    fn live_counts_are_stored_as_plc1_rounds_and_clips_them() {
+        // e x 32, rounded half up; clipped (and said so) only above 65,535.
+        assert_eq!(live_q32(0.0), (0, false));
+        assert_eq!(live_q32(1.0 / 64.0), (1, false));
+        assert_eq!(live_q32(0.015), (0, false));
+        assert_eq!(live_q32(2.5), (80, false));
+        assert_eq!(live_q32(65_535.4 / 32.0), (65_535, false));
+        assert_eq!(live_q32(65_535.6 / 32.0), (65_535, true));
+        assert_eq!(live_q32(f64::NAN), (0, false));
+        assert_eq!(live_u16(65_535), (65_535, false));
+        assert_eq!(live_u16(65_536), (65_535, true));
+    }
