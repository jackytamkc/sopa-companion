+        assert_eq!((&paused.genes, &paused.n, &paused.e), (&request.genes, &request.n, &request.e),
+                   "the same snapshot");
+        assert_eq!(finish, paused, "the same snapshot (n, e and f)");
+        writer.sampling_done(&model.voxels, &model.params);
+        assert_eq!(lines(&dir).len(), 5, "a finished run has no end count");
+        fs::remove_dir_all(&dir).unwrap();
+    }
