 impl ModelParams {
+    /// proseg-live: transcripts per cell, all assigned and non-background (row sums, in parallel).
+    pub fn live_cell_counts(&self) -> (Vec<u32>, Vec<u32>) {
+        // Sum the stored entries: `counts` is keyed by packed (gene, density, layer), not a dense gene range.
+        let assigned = self
+            .counts
+            .par_rows()
+            .map(|row| row.read().iter_nonzeros().map(|(_, v)| v).sum::<u32>())
+            .collect();
+        let foreground = self
+            .foreground_counts
+            .par_rows()
+            .map(|row| row.read().iter_nonzeros().map(|(_, v)| v).sum::<u32>())
+            .collect();
+        (assigned, foreground)
+    }
+
+    /// proseg-live: a read-only copy of the assignment as it is now (taken at the init frame for the start block).
+    pub fn live_start_copy(&self) -> LiveStartCounts {
+        let rows: Vec<Vec<(CountMatRowKey, u32)>> = self
+            .counts
+            .par_rows()
+            .with_min_len(RAYON_CELL_MIN_LEN)
+            .map(|row| row.read().iter_nonzeros().collect())
+            .collect();
+        let total = rows.iter().map(Vec::len).sum();
+        let mut copy = LiveStartCounts {
+            indptr: Vec::with_capacity(rows.len() + 1),
+            keys: Vec::with_capacity(total),
+            counts: Vec::with_capacity(total),
+        };
+        copy.indptr.push(0);
+        for row in rows {
+            for (key, count) in row {
+                copy.keys.push(key);
+                copy.counts.push(count);
+            }
+            copy.indptr.push(copy.keys.len());
+        }
+        copy
+    }
+
+    /// proseg-live: every cell's per-gene count now (see `LiveGeneCounts`): n and e always, f when `sampled`, and the
+    /// start block of `start`. e takes each entry's foreground probability exactly as the background split computes
+    /// it (paramsampler.rs sample_foreground_background), from the parameters as they are now, without its binomial
+    /// draw. Reads only: row read locks, no random number.
+    pub fn live_gene_counts(
+        &self,
+        sampled: bool,
+        unmodeled_fixed_cells: bool,
+        start: Option<&LiveStartCounts>,
+    ) -> LiveGeneCounts {
+        struct Row {
+            genes: Vec<u32>,
+            n: Vec<u16>,
+            e: Vec<u16>,
+            f: Vec<u16>,
+            start: Vec<u16>,
+            saturated: u64,
+            f_outside: u64,
+        }
+        let rows: Vec<Row> = self
+            .counts
+            .par_rows()
+            .zip(self.foreground_counts.par_rows())
+            .enumerate()
+            .with_min_len(RAYON_CELL_MIN_LEN)
+            .map(|(cell, (row, fg_row))| {
+                let φ_c = self.φ.row(cell);
+                let φ_c_factored = φ_c.slice(s![self.nunfactored..]);
+                let fixed = unmodeled_fixed_cells && self.frozen_cells[cell];
+                let rate = |g: usize| -> f32 {
+                    if g < self.nunfactored {
+                        φ_c[g]
+                    } else {
+                        φ_c_factored.dot(&self.θ.slice(s![g, self.nunfactored..]))
+                    }
+                };
+                // As the split's fg_prob (f32); 0/0 (no rate at all) keeps everything.
+                let kept = |λ_cg: f32, key: CountMatRowKey| -> f64 {
+                    if fixed {
+                        return 1.0;
+                    }
+                    let λ_bg = self.λ_bg[[key.gene() as usize, key.layer() as usize, key.density() as usize]];
+                    let p = λ_cg / (λ_cg + λ_bg);
+                    if p.is_nan() { 1.0 } else { p as f64 }
+                };
+                let mut out = Row {
+                    genes: Vec::new(),
+                    n: Vec::new(),
+                    e: Vec::new(),
+                    f: Vec::new(),
+                    start: Vec::new(),
+                    saturated: 0,
+                    f_outside: 0,
+                };
+                {
+                    let row = row.read();
+                    live_per_gene(row.iter_nonzeros(), &rate, &kept, |gene, n, e| {
+                        let (n, clipped_n) = live_u16(n);
+                        let (e, clipped_e) = live_q32(e);
+                        out.genes.push(gene);
+                        out.n.push(n);
+                        out.e.push(e);
+                        out.saturated += clipped_n as u64 + clipped_e as u64;
+                    });
+                }
+                if sampled {
+                    out.f = vec![0; out.genes.len()];
+                    let fg = fg_row.read();
+                    let mut at = 0;
+                    for (gene, count) in fg.iter_nonzeros() {
+                        while at < out.genes.len() && out.genes[at] < gene {
+                            at += 1;
+                        }
+                        if at < out.genes.len() && out.genes[at] == gene {
+                            let (f, clipped) = live_u16(count as u64);
+                            out.f[at] = f;
+                            out.saturated += clipped as u64;
+                        } else {
+                            out.f_outside += count as u64;
+                        }
+                    }
+                }
+                if let Some(copy) = start {
+                    let range = copy.indptr[cell]..copy.indptr[cell + 1];
+                    let entries = copy.keys[range.clone()].iter().copied().zip(copy.counts[range].iter().copied());
+                    live_per_gene(entries, &rate, &kept, |_gene, _n, e| {
+                        let (e, clipped) = live_q32(e);
+                        out.start.push(e);
+                        out.saturated += clipped as u64;
+                    });
+                }
+                out
+            })
+            .collect();
+        let nnz: usize = rows.iter().map(|row| row.genes.len()).sum();
+        let start_nnz: usize = rows.iter().map(|row| row.start.len()).sum();
+        if nnz > u32::MAX as usize || start_nnz > u32::MAX as usize {
+            panic!("proseg-live: too many (cell, gene) counts for one counts file ({nnz})");
+        }
+        let mut counts = LiveGeneCounts {
+            indptr: Vec::with_capacity(rows.len() + 1),
+            genes: Vec::with_capacity(nnz),
+            n: Vec::with_capacity(nnz),
+            e: Vec::with_capacity(nnz),
+            f: sampled.then(|| Vec::with_capacity(nnz)),
+            start: start.map(|_| Vec::with_capacity(start_nnz)),
+            saturated: 0,
+            f_outside: 0,
+        };
+        counts.indptr.push(0);
+        for row in rows {
+            counts.genes.extend_from_slice(&row.genes);
+            counts.n.extend_from_slice(&row.n);
+            counts.e.extend_from_slice(&row.e);
+            if let Some(f) = counts.f.as_mut() {
+                f.extend_from_slice(&row.f);
+            }
+            if let Some(s) = counts.start.as_mut() {
+                s.extend_from_slice(&row.start);
+            }
+            counts.saturated += row.saturated;
+            counts.f_outside += row.f_outside;
+            counts.indptr.push(counts.genes.len() as u32);
+        }
+        counts
+    }
