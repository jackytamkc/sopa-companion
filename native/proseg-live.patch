+        let rate = |gene: usize| gene as f32;
+        let kept = |λ_cg: f32, key: CountMatRowKey| (λ_cg / (λ_cg + 1.0 + key.layer() as f32)) as f64;
+        let mut seen = Vec::new();
+        live_per_gene(entries.iter().copied(), rate, kept, |gene, n, e| seen.push((gene, n, e)));
+        assert_eq!(seen.len(), 2);
+        assert_eq!((seen[0].0, seen[0].1, seen[1].0, seen[1].1), (3, 6, 7, 5));
+        assert!((seen[0].2 - (4.0 * 0.75 + 2.0 * 0.6)).abs() < 1e-6);
+        assert!((seen[1].2 - 5.0 * 7.0 / 8.0).abs() < 1e-6);
+        live_per_gene(std::iter::empty(), rate, kept, |_, _, _| panic!("no entries, no genes"));
+    }
