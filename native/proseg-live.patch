+/// proseg-live: one snapshot's count of every cell and gene (`ModelParams::live_gene_counts`), as live.rs exports it
+/// (PLC1). Rows are cells (cell = label - 1), columns the genes a cell has assigned transcripts of, ascending. Values are
+/// stored as u16, clipped at 65,535; `saturated` counts the clipped ones.
+#[derive(Clone, Debug)]
+pub struct LiveGeneCounts {
+    pub indptr: Vec<u32>,
+    pub genes: Vec<u32>,
+    /// n, the assigned count: `counts` summed over layer and density.
+    pub n: Vec<u16>,
+    /// e, the averaged count, x 32 rounded half up: the sum over the cell's (gene, layer, density) entries of
+    /// count x λ_cg / (λ_cg + λ_bg[g, layer, density]) (1 for frozen cells under unmodeled_fixed_cells), in f64, with
+    /// the snapshot's parameters.
+    pub e: Vec<u16>,
+    /// f, the sampled count (`foreground_counts`: the saved X at the end) on n's pattern, 0 where the draw kept none.
+    pub f: Option<Vec<u16>>,
+    /// The start block: e of the assignment at the init frame (`LiveStartCounts`) with this snapshot's parameters, x 32
+    /// as e, on that assignment's own pattern.
+    pub start: Option<Vec<u16>>,
+    pub saturated: u64,
+    /// Sampled counts outside n's pattern (none: the draw splits assigned counts; kept as a check).
+    pub f_outside: u64,
+}
+
+/// proseg-live: a read-only copy of `counts` at the init frame (each cell's (gene, layer, density) entries in key
+/// order), for the start block.
+pub struct LiveStartCounts {
+    indptr: Vec<usize>,
+    keys: Vec<CountMatRowKey>,
+    counts: Vec<u32>,
+}
+
+/// proseg-live: a count as PLC1 stores it (u16), and whether it was clipped.
+fn live_u16(value: u64) -> (u16, bool) {
+    if value > u16::MAX as u64 { (u16::MAX, true) } else { (value as u16, false) }
+}
+
+/// proseg-live: an averaged count as PLC1 stores it, floor(e x 32 + 0.5), and whether it was clipped.
+fn live_q32(e: f64) -> (u16, bool) {
+    let value = (e * 32.0 + 0.5).floor();
+    if value > u16::MAX as f64 { (u16::MAX, true) } else { (value.max(0.0) as u16, false) }
+}
+
+/// proseg-live: one cell's `counts` entries summed per gene, in order: `put(gene, n, e)` with n the entries' counts and
+/// e their counts x the foreground probability `kept(λ_cg, key)` (λ_cg = `rate(gene)`, once per gene). Entries are
+/// keyed (gene, density, layer) with the gene in the top bits, so one gene's entries are contiguous.
+fn live_per_gene(
+    entries: impl Iterator<Item = (CountMatRowKey, u32)>,
+    rate: impl Fn(usize) -> f32,
+    kept: impl Fn(f32, CountMatRowKey) -> f64,
+    mut put: impl FnMut(u32, u64, f64),
+) {
+    let (mut gene, mut λ_cg, mut n, mut e) = (u32::MAX, 0.0_f32, 0_u64, 0.0_f64);
+    for (key, count) in entries {
+        if key.gene() != gene {
+            if gene != u32::MAX {
+                put(gene, n, e);
+            }
+            gene = key.gene();
+            λ_cg = rate(gene as usize);
+            n = 0;
+            e = 0.0;
+        }
+        n += count as u64;
+        e += count as f64 * kept(λ_cg, key);
+    }
+    if gene != u32::MAX {
+        put(gene, n, e);
+    }
+}
