+    #[test]
+    fn where_exports_hold_every_pooled_transcript_observed_in_the_box() {
+        let mut model = Model::new();
+        for _ in 0..3 {
+            model.step(); // drift: entries away from where they were observed
+        }
+        let (assigned, _) = model.params.live_cell_counts();
+        // The whole field: every transcript once; per cell, its assigned count.
+        let all = model.voxels.live_where([-50.0, -50.0, 80.0, 80.0], 100.0);
+        let g = all.geometry;
+        assert_eq!((all.i0, all.j0, all.i1, all.j1), (0, 0, g.nx as i64 - 1, g.ny as i64 - 1));
+        assert_eq!(all.n.iter().map(|&n| n as u64).sum::<u64>(), NTRANSCRIPTS as u64);
+        for (c, &a) in assigned.iter().enumerate() {
+            let held: u32 = all.n.iter().zip(&all.dest).filter(|&(_, &d)| d == c as u32 + 1).map(|(&n, _)| n).sum();
+            assert_eq!(held, a, "cell {c}");
+        }
+        assert!(all.k.iter().all(|&k| (k as usize) < g.nlayers));
+        // A box: the records observed in its voxels (i, j relative to the grid), whatever the margin covers.
+        let bx = [8.0, 8.0, 22.0, 22.0];
+        let part = model.voxels.live_where(bx, 24.0);
+        assert_eq!((part.i0, part.i1), (((8.0 - g.x0) / g.voxelsize).floor() as i64, ((22.0 - g.x0) / g.voxelsize).floor() as i64));
+        let inside: u64 = all.i.iter().zip(&all.j).zip(&all.n)
+            .filter(|&((&i, &j), _)| (part.i0..=part.i1).contains(&(i as i64)) && (part.j0..=part.j1).contains(&(j as i64)))
+            .map(|(_, &n)| n as u64)
+            .sum();
+        assert_eq!(part.n.iter().map(|&n| n as u64).sum::<u64>(), inside);
+        assert!(part.i.iter().all(|&i| (part.i0..=part.i1).contains(&(i as i64))));
+        // The scan margin: an entry whose current voxel lies 24 µm (12 voxels) from where it was observed is found only
+        // when the quads that far from the box are scanned.
+        let observed = Voxel::new(g.i0 + 1, g.j0 + 5, 0);
+        let current = observed.offset_coords(12, 0, 0);
+        let quad = &model.voxels.quads[&(current.i() as u32 / model.voxels.quadsize as u32, current.j() as u32 / model.voxels.quadsize as u32)];
+        quad.counts.write().unwrap().counts.insert(
+            VoxelCountKey { voxel: current, gene: 7, offset: VoxelOffset::new(12, 0, 0) }, 1000);
+        let strip = [g.x0, g.y0, g.x0 + 4.0 * g.voxelsize, g.y0 + 30.0];
+        let near = model.voxels.live_where(strip, 2.0);
+        let far = model.voxels.live_where(strip, 30.0);
+        let planted = |w: &LiveWhere| (0..w.i.len()).any(|r| (w.i[r], w.j[r], w.k[r], w.gene[r], w.n[r]) == (1, 5, 0, 7, 1000));
+        assert!(!planted(&near) && planted(&far));
+        // where_margin: at least 20 µm, else 6 x diffusion-sigma-far.
+        assert_eq!((where_margin(4.0), where_margin(1.0), where_margin(0.0)), (24.0, 20.0, 20.0));
+    }
