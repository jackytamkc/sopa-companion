+
+// ---------------------------------------------------------------------------------------------------------------
+// proseg-live: a dense snapshot of the current segmentation, taken between sampler iterations.
+
+/// Labels are `cell index + 1`, with 0 for background, so a zero-initialised raster is all background.
+pub struct LiveRaster {
+    /// Grid index of raster column/row 0 (the minimum owned quad bound).
+    pub i0: i32,
+    pub j0: i32,
+    pub nx: usize,
+    pub ny: usize,
+    pub nlayers: usize,
+    /// Micrometre position of the lower-index corner of voxel (i0, j0), in the input transcript frame.
+    pub x0: f32,
+    pub y0: f32,
+    pub voxelsize: f32,
+    /// Transcript-weighted z projection: the winner of each (x, y) column exactly as in
+    /// `consensus_cell_polygons` (counts summed per cell across layers, background does not vote,
+    /// ties to the lowest cell index), before its empty-cell fallback and polygon tracing.
+    pub consensus: Vec<u32>,
+    /// Owned voxel labels per z layer, layer-major: `(k * ny + y) * nx + x`.
+    pub layers: Vec<u32>,
+}
+
+impl VoxelCheckerboard {
+    /// Proseg's prior segmentation as stored in the voxel states: per owned voxel, the prior cell (label = cell + 1,
+    /// 0 = none) and the prior probability x 1000 (nucleus prior vs cell prior), on the current grid. Layer-major,
+    /// same geometry as `live_raster`.
+    pub fn live_prior(&self) -> (LiveRaster, Vec<u32>) {
+        let mut geometry = self.live_raster();
+        let (nx, ny) = (geometry.nx, geometry.ny);
+        let plane = nx * ny;
+        let mut labels = vec![0u32; geometry.nlayers * plane];
+        let mut permille = vec![0u32; geometry.nlayers * plane];
+        for quad in self.quads.values() {
+            let states = quad.states.read().unwrap();
+            for (&voxel, state) in states.states.iter() {
+                if state.prior_cell == BACKGROUND_CELL || !state.log_prior.is_finite() || !quad.voxel_in_bounds(voxel) {
+                    continue;
+                }
+                let [i, j, k] = voxel.coords();
+                let p = k as usize * plane + (j - geometry.j0) as usize * nx + (i - geometry.i0) as usize;
+                labels[p] = state.prior_cell + 1;
+                permille[p] = (state.log_prior.to_f32().exp() * 1000.0).round() as u32;
+            }
+        }
+        geometry.layers = labels;
+        (geometry, permille)
+    }
+
+    /// (origin, spacing) of the voxel z grid in proseg's normalised z units: layer = (z - origin) / spacing.
+    pub fn live_z_grid(&self) -> (f32, f32) {
+        (self.zmin, self.voxelsize_z)
+    }
+
+    /// Inclusive grid bounds of every quad: the extent of all live rasters.
+    fn live_bounds(&self) -> (i32, i32, i32, i32) {
+        let mut bounds = (i32::MAX, i32::MIN, i32::MAX, i32::MIN);
+        for quad in self.quads.values() {
+            let (a, b, c, d) = quad.bounds();
+            bounds = (bounds.0.min(a), bounds.1.max(b), bounds.2.min(c), bounds.3.max(d));
+        }
+        if self.quads.is_empty() {
+            bounds = (0, 0, 0, 0);
+        }
+        bounds
+    }
+
+    pub fn live_raster(&self) -> LiveRaster {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        let nx = (i1 - i0 + 1) as usize;
+        let ny = (j1 - j0 + 1) as usize;
+        let nlayers = (self.kmax + 1).max(1) as usize;
+        let plane = nx.checked_mul(ny).expect("proseg-live: voxel grid overflow");
+        // One u32 per voxel in several arrays: refuse grids that cannot be snapshotted (the engine checks earlier).
+        if plane.checked_mul(nlayers).is_none_or(|n| n > 400_000_000) {
+            panic!("proseg-live: the voxel grid ({nx} x {ny} x {nlayers}) is too large to snapshot");
+        }
+        let mut layers = vec![0u32; nlayers * plane];
+        let mut weights = vec![0u32; nlayers * plane];
+
+        // Mirrored halo states and counts belong to the neighbouring quad: only owned voxels are read. Quads own
+        // disjoint voxel ranges, so each is gathered in parallel into its own buffers and then copied in by rows.
+        let quads: Vec<&VoxelQuad> = self.quads.values().collect();
+        let gathered: Vec<((i32, i32, i32, i32), Vec<u32>, Vec<u32>)> =
+            quads.par_iter().map(|quad| live_gather_quad(quad, nlayers)).collect();
+        for ((qi0, qi1, qj0, qj1), labels, counts_local) in gathered {
+            let qw = (qi1 - qi0 + 1) as usize;
+            let qh = (qj1 - qj0 + 1) as usize;
+            for k in 0..nlayers {
+                for y in 0..qh {
+                    let src = (k * qh + y) * qw;
+                    let dst = k * plane + ((qj0 - j0) as usize + y) * nx + (qi0 - i0) as usize;
+                    layers[dst..dst + qw].copy_from_slice(&labels[src..src + qw]);
+                    weights[dst..dst + qw].copy_from_slice(&counts_local[src..src + qw]);
+                }
+            }
+        }
+
+        let mut consensus = vec![0u32; plane];
+        consensus
+            .par_chunks_mut(nx.max(1))
+            .enumerate()
+            .for_each(|(row, out)| {
+                let mut votes: Vec<(u32, u32)> = Vec::with_capacity(nlayers);
+                for (x, slot) in out.iter_mut().enumerate() {
+                    *slot = live_vote(&layers, &weights, plane, row * nx + x, nlayers, &mut votes);
+                }
+            });
+
+        LiveRaster {
+            i0,
+            j0,
+            nx,
+            ny,
+            nlayers,
+            x0: self.xmin + i0 as f32 * self.voxelsize,
+            y0: self.ymin + j0 as f32 * self.voxelsize,
+            voxelsize: self.voxelsize,
+            consensus,
+            layers,
+        }
+    }
+}
+
+/// One quad's owned voxels as dense per-layer arrays (labels = cell + 1, transcript counts), local to the quad:
+/// `(k * qh + y) * qw + x`. Mirrored halo states and counts belong to the neighbouring quad and are skipped.
+fn live_gather_quad(quad: &VoxelQuad, nlayers: usize) -> ((i32, i32, i32, i32), Vec<u32>, Vec<u32>) {
+    let (qi0, qi1, qj0, qj1) = quad.bounds();
+    let qw = (qi1 - qi0 + 1) as usize;
+    let qh = (qj1 - qj0 + 1) as usize;
+    let local = |voxel: Voxel| -> usize {
+        let [i, j, k] = voxel.coords();
+        (k as usize * qh + (j - qj0) as usize) * qw + (i - qi0) as usize
+    };
+    let mut labels = vec![0u32; nlayers * qw * qh];
+    let mut counts_local = vec![0u32; nlayers * qw * qh];
+    {
+        let states = quad.states.read().unwrap();
+        for (&voxel, state) in states.states.iter() {
+            if state.cell != BACKGROUND_CELL && quad.voxel_in_bounds(voxel) {
+                labels[local(voxel)] = state.cell + 1;
+            }
+        }
+    }
+    {
+        let counts = quad.counts.read().unwrap();
+        for (key, &count) in counts.counts.iter() {
+            if quad.voxel_in_bounds(key.voxel) {
+                let p = local(key.voxel);
+                counts_local[p] = counts_local[p].saturating_add(count);
+            }
+        }
+    }
+    (quad.bounds(), labels, counts_local)
+}
+
+/// The 2-D projection rule of `consensus_cell_polygons`: transcript counts summed per cell across the column's layers,
+/// background does not vote, ties go to the lowest label. `p` indexes a plane of `plane` columns.
+fn live_vote(labels: &[u32], weights: &[u32], plane: usize, p: usize, nlayers: usize, votes: &mut Vec<(u32, u32)>) -> u32 {
+    votes.clear();
+    for k in 0..nlayers {
+        let label = labels[k * plane + p];
+        if label != 0 {
+            votes.push((label, weights[k * plane + p]));
+        }
+    }
+    if votes.is_empty() {
+        return 0;
+    }
+    votes.sort_unstable();
+    let (mut winner, mut best) = (0u32, 0u32);
+    let mut a = 0;
+    while a < votes.len() {
+        let label = votes[a].0;
+        let mut sum = 0u32;
+        while a < votes.len() && votes[a].0 == label {
+            sum = sum.saturating_add(votes[a].1);
+            a += 1;
+        }
+        if winner == 0 || sum > best {
+            winner = label;
+            best = sum;
+        }
+    }
+    winner
+}
+
+/// Per-layer labels of a rectangle of the raster (columns `i0..i0 + nx`, rows `j0..j0 + ny`, relative to the raster's
+/// column/row 0), layer-major `(k * ny + y) * nx + x`.
+pub struct LiveWindow {
+    pub i0: usize,
+    pub j0: usize,
+    pub nx: usize,
+    pub ny: usize,
+    pub layers: Vec<u32>,
+}
+
+/// proseg-live's tiled snapshot for regions too large for a dense per-layer raster: the 2-D projection of the whole
+/// grid (computed quad by quad, the per-layer volume is never materialised), the voxel count of every cell, and the
+/// per-layer labels of one window (the part of the tissue the viewer shows).
+pub struct LiveTiled {
+    pub i0: i32,
+    pub j0: i32,
+    pub nx: usize,
+    pub ny: usize,
+    pub nlayers: usize,
+    pub x0: f32,
+    pub y0: f32,
+    pub voxelsize: f32,
+    pub consensus: Vec<u32>,
+    /// Indexed by label (cell + 1); entry 0 unused.
+    pub voxels: Vec<u32>,
+    pub window: Option<LiveWindow>,
+}
+
+impl VoxelCheckerboard {
+    /// The raster rectangle covering `view` (µm, x0 y0 x1 y1), at most `max` columns/rows on a side (centred), or
+    /// None when it misses the grid. Returned relative to the raster: (i0, j0, nx, ny).
+    fn live_window_rect(&self, view: [f32; 4], max: usize) -> Option<(usize, usize, usize, usize)> {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        let (nx, ny) = ((i1 - i0 + 1) as i64, (j1 - j0 + 1) as i64);
+        let column = |x: f32| ((x - self.xmin) / self.voxelsize).floor() as i64 - i0 as i64;
+        let row = |y: f32| ((y - self.ymin) / self.voxelsize).floor() as i64 - j0 as i64;
+        let clamp = |a: i64, b: i64, n: i64| -> (i64, i64) {
+            let (mut a, mut b) = (a.clamp(0, n), (b + 1).clamp(0, n));
+            if b - a > max as i64 {
+                let centre = (a + b) / 2;
+                a = (centre - max as i64 / 2).clamp(0, n);
+                b = (a + max as i64).min(n);
+            }
+            (a, b)
+        };
+        let (a, b) = clamp(column(view[0].min(view[2])), column(view[0].max(view[2])), nx);
+        let (c, d) = clamp(row(view[1].min(view[3])), row(view[1].max(view[3])), ny);
+        (b > a && d > c).then_some((a as usize, c as usize, (b - a) as usize, (d - c) as usize))
+    }
+
+    /// Copy one quad's per-layer labels that fall inside `rect` (raster-relative) into `out` (the window's layers).
+    fn live_copy_window(
+        rect: (usize, usize, usize, usize),
+        origin: (i32, i32),
+        bounds: (i32, i32, i32, i32),
+        labels: &[u32],
+        nlayers: usize,
+        out: &mut [u32],
+    ) {
+        let (wi0, wj0, wnx, wny) = rect;
+        let (qi0, qi1, qj0, qj1) = bounds;
+        let (qw, qh) = ((qi1 - qi0 + 1) as usize, (qj1 - qj0 + 1) as usize);
+        // Quad origin relative to the raster.
+        let (qx, qy) = ((qi0 - origin.0) as usize, (qj0 - origin.1) as usize);
+        let (x_from, x_to) = (qx.max(wi0), (qx + qw).min(wi0 + wnx));
+        let (y_from, y_to) = (qy.max(wj0), (qy + qh).min(wj0 + wny));
+        if x_from >= x_to || y_from >= y_to {
+            return;
+        }
+        for k in 0..nlayers {
+            for y in y_from..y_to {
+                let src = (k * qh + (y - qy)) * qw + (x_from - qx);
+                let dst = (k * wny + (y - wj0)) * wnx + (x_from - wi0);
+                out[dst..dst + (x_to - x_from)].copy_from_slice(&labels[src..src + (x_to - x_from)]);
+            }
+        }
+    }
+
+    pub fn live_tiled(&self, view: Option<[f32; 4]>, max_window: usize, ncells: usize) -> LiveTiled {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        let nx = (i1 - i0 + 1) as usize;
+        let ny = (j1 - j0 + 1) as usize;
+        let nlayers = (self.kmax + 1).max(1) as usize;
+        let plane = nx.checked_mul(ny).expect("proseg-live: voxel grid overflow");
+        // A few whole-grid u32 planes live at once (here, in the writer and its change tracker); the engine refuses
+        // larger grids before starting, this is the last line of defence.
+        if plane > 400_000_000 {
+            panic!("proseg-live: the voxel grid ({nx} x {ny}) is too large for tiled snapshots; use larger voxels");
+        }
+        let rect = view.and_then(|v| self.live_window_rect(v, max_window));
+        let quads: Vec<&VoxelQuad> = self.quads.values().collect();
+        // Each quad projects its own columns and counts its cells' voxels; only the window keeps layers.
+        let parts: Vec<((i32, i32, i32, i32), Vec<u32>, Vec<(u32, u32)>, Option<Vec<u32>>)> = quads
+            .par_iter()
+            .map(|quad| {
+                let (bounds, labels, weights) = live_gather_quad(quad, nlayers);
+                let (qi0, qi1, qj0, qj1) = bounds;
+                let qplane = ((qi1 - qi0 + 1) * (qj1 - qj0 + 1)) as usize;
+                let mut votes: Vec<(u32, u32)> = Vec::with_capacity(nlayers);
+                let projected: Vec<u32> = (0..qplane)
+                    .map(|p| live_vote(&labels, &weights, qplane, p, nlayers, &mut votes))
+                    .collect();
+                let mut sorted: Vec<u32> = labels.iter().copied().filter(|&l| l != 0).collect();
+                sorted.sort_unstable();
+                let mut counts: Vec<(u32, u32)> = Vec::new();
+                for label in sorted {
+                    match counts.last_mut() {
+                        Some((l, n)) if *l == label => *n += 1,
+                        _ => counts.push((label, 1)),
+                    }
+                }
+                let window = rect.and_then(|r| {
+                    let (wi0, wj0, wnx, wny) = r;
+                    let (qx, qy) = ((qi0 - i0) as usize, (qj0 - j0) as usize);
+                    let (qw, qh) = ((qi1 - qi0 + 1) as usize, (qj1 - qj0 + 1) as usize);
+                    let overlaps = qx < wi0 + wnx && wi0 < qx + qw && qy < wj0 + wny && wj0 < qy + qh;
+                    overlaps.then_some(labels)
+                });
+                (bounds, projected, counts, window)
+            })
+            .collect();
+        let mut consensus = vec![0u32; plane];
+        let mut voxels = vec![0u32; ncells + 1];
+        let mut window = rect.map(|(wi0, wj0, wnx, wny)| LiveWindow {
+            i0: wi0,
+            j0: wj0,
+            nx: wnx,
+            ny: wny,
+            layers: vec![0u32; nlayers * wnx * wny],
+        });
+        for (bounds, projected, counts, labels) in parts {
+            let (qi0, qi1, qj0, qj1) = bounds;
+            let qw = (qi1 - qi0 + 1) as usize;
+            for (y, row) in projected.chunks(qw).enumerate() {
+                let dst = ((qj0 - j0) as usize + y) * nx + (qi0 - i0) as usize;
+                consensus[dst..dst + qw].copy_from_slice(row);
+            }
+            let _ = qj1;
+            for (label, n) in counts {
+                if let Some(slot) = voxels.get_mut(label as usize) {
+                    *slot += n;
+                }
+            }
+            if let (Some(w), Some(labels)) = (window.as_mut(), labels) {
+                Self::live_copy_window((w.i0, w.j0, w.nx, w.ny), (i0, j0), bounds, &labels, nlayers, &mut w.layers);
+            }
+        }
+        LiveTiled {
+            i0,
+            j0,
+            nx,
+            ny,
+            nlayers,
+            x0: self.xmin + i0 as f32 * self.voxelsize,
+            y0: self.ymin + j0 as f32 * self.voxelsize,
+            voxelsize: self.voxelsize,
+            consensus,
+            voxels,
+            window,
+        }
+    }
+
+    /// Only the window's per-layer labels (for a paused run whose view moved): touches the quads it overlaps.
+    pub fn live_window(&self, view: [f32; 4], max_window: usize) -> Option<(LiveTiled, LiveWindow)> {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        let nlayers = (self.kmax + 1).max(1) as usize;
+        let (wi0, wj0, wnx, wny) = self.live_window_rect(view, max_window)?;
+        let mut layers = vec![0u32; nlayers * wnx * wny];
+        let quads: Vec<&VoxelQuad> = self
+            .quads
+            .values()
+            .filter(|quad| {
+                let (qi0, qi1, qj0, qj1) = quad.bounds();
+                let (a, b) = ((qi0 - i0) as usize, (qi1 - i0) as usize);
+                let (c, d) = ((qj0 - j0) as usize, (qj1 - j0) as usize);
+                a < wi0 + wnx && wi0 <= b && c < wj0 + wny && wj0 <= d
+            })
+            .collect();
+        let parts: Vec<((i32, i32, i32, i32), Vec<u32>)> = quads
+            .par_iter()
+            .map(|quad| {
+                let (bounds, labels, _) = live_gather_quad(quad, nlayers);
+                (bounds, labels)
+            })
+            .collect();
+        for (bounds, labels) in parts {
+            Self::live_copy_window((wi0, wj0, wnx, wny), (i0, j0), bounds, &labels, nlayers, &mut layers);
+        }
+        let geometry = LiveTiled {
+            i0,
+            j0,
+            nx: (i1 - i0 + 1) as usize,
+            ny: (j1 - j0 + 1) as usize,
+            nlayers,
+            x0: self.xmin + i0 as f32 * self.voxelsize,
+            y0: self.ymin + j0 as f32 * self.voxelsize,
+            voxelsize: self.voxelsize,
+            consensus: Vec::new(),
+            voxels: Vec::new(),
+            window: None,
+        };
+        Some((geometry, LiveWindow { i0: wi0, j0: wj0, nx: wnx, ny: wny, layers }))
+    }
+
+    /// Proseg's prior projected to 2-D for tiled runs: per column, the prior cell (label = cell + 1) and probability
+    /// x 1000 of its strongest layer (ties to the lowest layer). Same geometry as `live_tiled`.
+    pub fn live_prior_projection(&self) -> (LiveTiled, Vec<u32>, Vec<u32>) {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        let nx = (i1 - i0 + 1) as usize;
+        let ny = (j1 - j0 + 1) as usize;
+        let quads: Vec<&VoxelQuad> = self.quads.values().collect();
+        let parts: Vec<((i32, i32, i32, i32), Vec<u32>, Vec<u32>)> = quads
+            .par_iter()
+            .map(|quad| {
+                let bounds = quad.bounds();
+                let (qi0, qi1, qj0, qj1) = bounds;
+                let qw = (qi1 - qi0 + 1) as usize;
+                let qh = (qj1 - qj0 + 1) as usize;
+                let mut labels = vec![0u32; qw * qh];
+                let mut permille = vec![0u32; qw * qh];
+                let mut layer = vec![u32::MAX; qw * qh];
+                let states = quad.states.read().unwrap();
+                for (&voxel, state) in states.states.iter() {
+                    if state.prior_cell == BACKGROUND_CELL || !state.log_prior.is_finite() || !quad.voxel_in_bounds(voxel) {
+                        continue;
+                    }
+                    let [i, j, k] = voxel.coords();
+                    let p = (j - qj0) as usize * qw + (i - qi0) as usize;
+                    let value = (state.log_prior.to_f32().exp() * 1000.0).round() as u32;
+                    if value > permille[p] || (value == permille[p] && (k as u32) < layer[p]) {
+                        permille[p] = value;
+                        labels[p] = state.prior_cell + 1;
+                        layer[p] = k as u32;
+                    }
+                }
+                (bounds, labels, permille)
+            })
+            .collect();
+        let mut labels = vec![0u32; nx * ny];
+        let mut permille = vec![0u32; nx * ny];
+        for ((qi0, qi1, qj0, _), quad_labels, quad_permille) in parts {
+            let qw = (qi1 - qi0 + 1) as usize;
+            for (y, (row_labels, row_permille)) in quad_labels.chunks(qw).zip(quad_permille.chunks(qw)).enumerate() {
+                let dst = ((qj0 - j0) as usize + y) * nx + (qi0 - i0) as usize;
+                labels[dst..dst + qw].copy_from_slice(row_labels);
+                permille[dst..dst + qw].copy_from_slice(row_permille);
+            }
+        }
+        let geometry = LiveTiled {
+            i0,
+            j0,
+            nx,
+            ny,
+            nlayers: 1,
+            x0: self.xmin + i0 as f32 * self.voxelsize,
+            y0: self.ymin + j0 as f32 * self.voxelsize,
+            voxelsize: self.voxelsize,
+            consensus: Vec::new(),
+            voxels: Vec::new(),
+            window: None,
+        };
+        (geometry, labels, permille)
+    }
+}
+
+/// proseg-live: the grid every live raster of the current state shares (the extent of all quads: `live_raster`,
+/// `live_tiled`) and its micrometre frame.
+#[derive(Clone, Copy, Debug)]
+pub struct LiveGeometry {
+    pub i0: i32,
+    pub j0: i32,
+    pub nx: usize,
+    pub ny: usize,
+    pub nlayers: usize,
+    pub x0: f32,
+    pub y0: f32,
+    pub voxelsize: f32,
+}
+
+/// proseg-live "where": proseg's pooled transcripts whose observed voxel lies in a box, one record per pooled entry
+/// (current voxel, gene, offset): the observed voxel (i, j relative to the grid's column/row 0, layer k), the gene, the
+/// label of the cell owning the current voxel (0 = none) and the entry's count. `i0..=i1` x `j0..=j1` is the box on the
+/// grid (empty when i0 > i1 or j0 > j1).
+pub struct LiveWhere {
+    pub geometry: LiveGeometry,
+    pub i0: i64,
+    pub j0: i64,
+    pub i1: i64,
+    pub j1: i64,
+    pub i: Vec<u32>,
+    pub j: Vec<u32>,
+    pub k: Vec<u8>,
+    pub gene: Vec<u32>,
+    pub dest: Vec<u32>,
+    pub n: Vec<u32>,
+}
+
+impl VoxelCheckerboard {
+    pub fn live_geometry(&self) -> LiveGeometry {
+        let (i0, i1, j0, j1) = self.live_bounds();
+        LiveGeometry {
+            i0,
+            j0,
+            nx: (i1 - i0 + 1) as usize,
+            ny: (j1 - j0 + 1) as usize,
+            nlayers: (self.kmax + 1).max(1) as usize,
+            x0: self.xmin + i0 as f32 * self.voxelsize,
+            y0: self.ymin + j0 as f32 * self.voxelsize,
+            voxelsize: self.voxelsize,
+        }
+    }
+
+    /// The pooled transcripts observed in `bx` (µm, x0 y0 x1 y1) and where proseg holds them now (`LiveWhere`). Entries
+    /// are kept in the quad of their current voxel, so only the quads overlapping `bx` grown by `margin_um` are scanned:
+    /// a transcript repositioned farther than that from where it was observed is not found. Reads only.
+    pub fn live_where(&self, bx: [f32; 4], margin_um: f32) -> LiveWhere {
+        let geometry = self.live_geometry();
+        let voxel = geometry.voxelsize;
+        let column = |x: f32| ((x - geometry.x0) / voxel).floor() as i64;
+        let row = |y: f32| ((y - geometry.y0) / voxel).floor() as i64;
+        let (i0, i1) = (column(bx[0]).max(0), column(bx[2]).min(geometry.nx as i64 - 1));
+        let (j0, j1) = (row(bx[1]).max(0), row(bx[3]).min(geometry.ny as i64 - 1));
+        let mut found = LiveWhere {
+            geometry,
+            i0,
+            j0,
+            i1,
+            j1,
+            i: Vec::new(),
+            j: Vec::new(),
+            k: Vec::new(),
+            gene: Vec::new(),
+            dest: Vec::new(),
+            n: Vec::new(),
+        };
+        if i0 > i1 || j0 > j1 {
+            return found;
+        }
+        // Grid coordinates (not raster-relative) of the box and of the scanned area.
+        let (gi, gj) = (geometry.i0 as i64, geometry.j0 as i64);
+        let (ai0, ai1, aj0, aj1) = (gi + i0, gi + i1, gj + j0, gj + j1);
+        let (si0, si1) = (gi + column(bx[0] - margin_um), gi + column(bx[2] + margin_um));
+        let (sj0, sj1) = (gj + row(bx[1] - margin_um), gj + row(bx[3] + margin_um));
+        let mut keys: Vec<(u32, u32)> = self
+            .quads
+            .iter()
+            .filter(|(_, quad)| {
+                let (qi0, qi1, qj0, qj1) = quad.bounds();
+                (qi0 as i64) <= si1 && si0 <= qi1 as i64 && (qj0 as i64) <= sj1 && sj0 <= qj1 as i64
+            })
+            .map(|(key, _)| *key)
+            .collect();
+        keys.sort_unstable();
+        type Records = (Vec<u32>, Vec<u32>, Vec<u8>, Vec<u32>, Vec<u32>, Vec<u32>);
+        let parts: Vec<Records> = keys
+            .par_iter()
+            .map(|key| {
+                let quad = &self.quads[key];
+                let counts = quad.counts.read().unwrap();
+                let states = quad.states.read().unwrap();
+                let mut part: Records = Default::default();
+                for (key, &count) in counts.counts.iter() {
+                    if count == 0 {
+                        continue;
+                    }
+                    let observed = key.voxel.offset(-key.offset);
+                    if observed.is_oob() {
+                        continue;
+                    }
+                    let [i, j, k] = observed.coords();
+                    let (i, j) = (i as i64, j as i64);
+                    if i < ai0 || i > ai1 || j < aj0 || j > aj1 {
+                        continue;
+                    }
+                    let cell = states.states.get(&key.voxel).map_or(BACKGROUND_CELL, |state| state.cell);
+                    part.0.push((i - gi) as u32);
+                    part.1.push((j - gj) as u32);
+                    part.2.push(k as u8);
+                    part.3.push(key.gene);
+                    part.4.push(if cell == BACKGROUND_CELL { 0 } else { cell + 1 });
+                    part.5.push(count);
+                }
+                part
+            })
+            .collect();
+        for (i, j, k, gene, dest, n) in parts {
+            found.i.extend(i);
+            found.j.extend(j);
+            found.k.extend(k);
+            found.gene.extend(gene);
+            found.dest.extend(dest);
+            found.n.extend(n);
+        }
+        found
+    }
+}
