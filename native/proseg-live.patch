+    #[test]
+    fn the_counts_writer_commits_a_jobs_files_in_order_and_its_line_last() {
+        // The count file, its sidecar, the where export and where.json, then the line (the commit point). A folder
+        // where one of them goes makes its write fail: the files before it are in place, none after it, and no line.
+        let model = Model::new();
+        let order = ["frames/000001.counts.zst", "frames/000001.counted.zst", "where-1.bin.zst", "where.json"];
+        for (k, failing) in order.iter().enumerate() {
+            let dir = scratch(&format!("order-{k}"));
+            fs::create_dir_all(dir.join("frames")).unwrap();
+            fs::create_dir_all(dir.join(failing).join("in-the-way")).unwrap();
+            File::create(dir.join("counts.jsonl")).unwrap();
+            let written = Arc::new(AtomicU64::new(0));
+            let (sender, worker) = spawn_counts_writer(dir.clone(), written.clone(), Arc::new(Mutex::new(Vec::new())));
+            sender.send(counts_job(&model, 1, dir.join(order[0]), order[0].into(), true)).unwrap();
+            drop(sender);
+            assert!(worker.join().is_err(), "a write that fails stops the counts writer ({failing})");
+            assert_eq!((written.load(Ordering::Acquire), lines(&dir).len()), (0, 0), "no line without {failing}");
+            for earlier in &order[..k] {
+                assert!(dir.join(earlier).is_file(), "{earlier} is written before {failing}");
+            }
+            for later in &order[k + 1..] {
+                assert!(!dir.join(later).exists(), "{later} is written after {failing}");
+            }
+            let names: Vec<String> = fs::read_dir(&dir).unwrap().chain(fs::read_dir(dir.join("frames")).unwrap())
+                .map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();
+            assert!(names.iter().all(|n| !n.ends_with(".tmp")), "no part left behind: {names:?}");
+            fs::remove_dir_all(&dir).unwrap();
+        }
+    }
