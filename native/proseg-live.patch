+    #[test]
+    fn the_hold_counts_its_state_durably_once_and_before_its_ack() {
+        let dir = scratch("hold");
+        let spool = dir.join("spool");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(Some(&spool), false, Some(1)));
+        model.frame(&mut writer, "init", 0);
+        writer.drain();
+        // The schedule's last iteration, counted on request (spool, no f).
+        fs::write(dir.join("control"), "counts 1\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "hillclimb", 1);
+        writer.drain();
+        // The hold's count is kept back on its way to the counts writer: no paused ack and no schedule_done meanwhile.
+        let gate = Gate::install(&mut writer);
+        gate.hold();
+        let watcher = {
+            let dir = dir.clone();
+            std::thread::spawn(move || {
+                let mut problems: Vec<String> = Vec::new();
+                let held = gate.held();
+                if held != Some((1, Reason::Hold)) {
+                    problems.push(format!("kept back {held:?}, not the hold's count of seq 1"));
+                }
+                let told = || {
+                    dir.join("schedule_done").exists() || read_json(&dir.join("ack")).is_some_and(|a| a["state"] != "running")
+                };
+                if seen(Duration::from_millis(300), told) || lines(&dir).len() != 2 {
+                    problems.push(format!("while the hold's count was unwritten: ack {:?}, schedule_done {}, lines {:?}",
+                                          read_json(&dir.join("ack")), dir.join("schedule_done").exists(), lines(&dir)));
+                }
+                gate.release();
+                if !until(|| dir.join("schedule_done").is_file()) {
+                    problems.push("no schedule_done".into());
+                }
+                let ack = read_json(&dir.join("ack")).unwrap_or(Value::Null);
+                let all = lines(&dir);
+                if ack["state"] != "paused" || ack["seq"] != 1 || all.len() != 3 || all[2]["reason"] != "hold"
+                    || all[2]["seq"] != 1 {
+                    problems.push(format!("at schedule_done: ack {ack}, lines {all:?}"));
+                }
+                // While held: a counts token is served without a line; a where token is exported at once.
+                let _ = fs::write(dir.join("control"), "counts 2\nwhere 3 0.00 0.00 30.00 30.00\n");
+                if !until(|| read_json(&dir.join("where.json")).is_some_and(|w| w["token"] == 3)) {
+                    problems.push("no where export while held".into());
+                }
+                if lines(&dir).len() != 3 {
+                    problems.push("a line for a token read while held".into());
+                }
+                let _ = fs::write(dir.join("control"), "counts 2\nwhere 3 0.00 0.00 30.00 30.00\nfinish 1\n");
+                problems
+            })
+        };
+        assert!(!writer.hold(&model.voxels, &model.params));
+        let problems = watcher.join().unwrap();
+        assert!(problems.is_empty(), "{problems:?}");
+        let all = lines(&dir);
+        assert_eq!(all.len(), 3, "the finish needs no count of its own: the hold's is durable");
+        assert_eq!(all[2]["file"], json!("frames/000001.counts.zst"));
+        let hold = check_counts(&dir, &all[2], &model);
+        assert!(hold.f.is_some() && hold.start.is_some());
+        let request = read_plc1(&line_file(&dir, &all[1]));
+        assert_eq!((&hold.n, &hold.e, &hold.genes), (&request.n, &request.e, &request.genes));
+        assert_eq!(hold.start, request.start, "both carry the start block (--live-counts-start 1)");
+        let ack = read_json(&dir.join("ack")).unwrap();
+        assert_eq!((ack["state"].as_str(), ack["seq"].as_u64()), (Some("finishing"), Some(1)));
+        // A where export of the whole field: every transcript, each counted once.
+        let w = read_json(&dir.join("where.json")).unwrap();
+        assert_eq!((w["seq"].as_u64(), w["i0"].as_i64(), w["j0"].as_i64()), (Some(1), Some(0), Some(0)));
+        let export = zstd::bulk::decompress(&fs::read(dir.join("where-3.bin.zst")).unwrap(), 1 << 30).unwrap();
+        let count = u32::from_le_bytes(export[..4].try_into().unwrap()) as usize;
+        assert_eq!((count, export.len()), (w["entries"].as_u64().unwrap() as usize, 4 + 21 * count));
+        let n: u64 = export[4 + 17 * count..].chunks(4).map(|c| u32::from_le_bytes(c.try_into().unwrap()) as u64).sum();
+        assert_eq!(n, NTRANSCRIPTS as u64);
+        writer.sampling_done(&model.voxels, &model.params);
+        assert_eq!(lines(&dir).len(), 3);
+        fs::remove_dir_all(&dir).unwrap();
+    }
