+    #[test]
+    fn the_start_block_goes_with_every_kth_frame_counted_and_a_frame_counted_again_is_no_new_one() {
+        // --live-counts-start K: the start block with every forced count and every K-th frame counted. A frame counted
+        // again (a pause on a frame a token counted, the hold on one, the end) is the same frame: the frames counted
+        // after it keep their places. K = 3: init (the 1st frame), the token's frame seq 1 (2nd) and the pause's count
+        // of it again, seq 2 (3rd: the start block) and the hold's count of it again, then seq 3, 4 and 5 (the 6th: the
+        // start block) as the run samples on, and the end's count of seq 5 again.
+        let dir = scratch("start-kth");
+        let spool = dir.join("spool");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(Some(&spool), false, Some(3)));
+        let control = dir.join("control");
+        model.frame(&mut writer, "init", 0);
+        writer.drain();
+        fs::write(&control, "counts 1\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "sampling", 1);
+        writer.drain();
+        fs::write(&control, "counts 1\npaused 1\nstep 0\n").unwrap();
