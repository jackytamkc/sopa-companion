+    #[test]
+    fn a_frame_counted_first_at_a_pause_the_hold_or_an_upscale_is_a_new_one_in_the_kth() {
+        // A pause on a frame not counted yet, the hold on a last frame not counted yet and an upscale each count a frame
+        // for the first time (forced: with f and the start block). It is a new frame counted, and the frames counted
+        // after it go by it (the n-th counted frame in seq order carries the start block when n % K is 0). K = 3: init
+        // (the 1st frame), the pause's count of seq 1 (2nd), the tokens' seq 2 (3rd: the start block) and seq 3, the
+        // upscale's seq 4 (5th), the tokens' seq 5 (6th: the start block) and seq 6, the hold's count of seq 7 (8th),
+        // then the tokens' seq 8 (9th: the start block) and seq 9 as the run samples on, and the end's count of seq 9
+        // again.
+        let dir = scratch("start-first");
+        let spool = dir.join("spool");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(Some(&spool), false, Some(3)));
+        let control = dir.join("control");
+        // A new counts token read while running, the counts writer idle: the next frame is counted for it.
+        let asked = |writer: &mut LiveWriter, model: &mut Model, tokens: &str, phase: &str, iteration: usize| {
+            fs::write(&control, tokens).unwrap();
+            assert!(writer.wait(&model.voxels, &model.params));
+            model.step();
+            model.frame(writer, phase, iteration);
+            writer.drain();
+        };
+        model.frame(&mut writer, "init", 0);
+        model.step();
+        model.frame(&mut writer, "burnin", 1);
+        writer.drain();
+        // A pause on seq 1, not counted yet: the pause counts it, then the run resumes.
+        fs::write(&control, "paused 1\nstep 0\n").unwrap();
+        let resumer = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let paused = until(|| {
+                    read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == 1)
+                });
+                let _ = fs::write(&control, "paused 0\nstep 0\n");
+                paused
+            })
+        };
+        assert!(writer.wait(&model.voxels, &model.params));
+        assert!(resumer.join().unwrap(), "no paused ack at seq 1");
+        asked(&mut writer, &mut model, "counts 1\n", "burnin", 2);
+        asked(&mut writer, &mut model, "counts 2\n", "burnin", 3);
+        // The refinement's frame, seq 4: counted.
+        model.frame(&mut writer, "upscale", 3);
+        writer.drain();
+        asked(&mut writer, &mut model, "counts 3\n", "sampling", 4);
+        asked(&mut writer, &mut model, "counts 4\n", "hillclimb", 5);
+        // The schedule's last frame, seq 7, taken but not counted: the hold counts it, durably, and the run samples on.
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "hillclimb", 6);
+        writer.drain();
+        fs::write(&control, "counts 4\ncontinue 1\n").unwrap();
+        assert!(writer.hold(&model.voxels, &model.params));
+        asked(&mut writer, &mut model, "counts 5\ncontinue 1\n", "continued", 7);
+        asked(&mut writer, &mut model, "counts 6\ncontinue 1\n", "continued", 8);
+        writer.sampling_done(&model.voxels, &model.params);
+        let all = lines(&dir);
+        let seen: Vec<(u64, &str, bool, bool)> = all.iter()
+            .map(|l| (l["seq"].as_u64().unwrap(), l["reason"].as_str().unwrap(), l["has_f"] == json!(true),
+                      l["has_start"] == json!(true)))
+            .collect();
+        assert_eq!(seen, [(0, "init", true, true), (1, "pause", true, true), (2, "request", false, true),
+                          (3, "request", false, false), (4, "upscale", true, true), (5, "request", false, true),
+                          (6, "request", false, false), (7, "hold", true, true), (8, "request", false, true),
+                          (9, "request", false, false), (9, "end", true, true)]);
+        // Each file holds what its line says: f, and the start block on the init frame's pattern.
+        let init = read_plc1(&dir.join("frames/000000.counts.zst"));
+        for line in &all {
+            let file = read_plc1(&line_file(&dir, line));
+            let start = (line["has_start"] == json!(true)).then_some(init.genes.len());
+            assert_eq!((file.f.is_some(), file.start.as_ref().map(Vec::len)), (line["has_f"] == json!(true), start),
+                       "{line}");
+        }
+        check_counts(&dir, &all[10], &model);
+        fs::remove_dir_all(&dir).unwrap();
+    }
