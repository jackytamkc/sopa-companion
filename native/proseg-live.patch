+    /// A counts job of the model's state as it is now, with f, for frame `seq` (and a where export with that token),
+    /// whose count file goes to `path`, named `name` in its line.
+    fn counts_job(model: &Model, seq: u64, path: PathBuf, name: String, place: bool) -> CountsJob {
+        let place = place.then(|| {
+            let ask = WhereAsk { token: seq, bx: [0.0, 0.0, 10.0, 10.0] };
+            let found = model.voxels.live_where(ask.bx, 24.0);
+            WhereExport { meta: where_meta(ask, seq, seq as usize, 24.0, &found), found }
+        });
+        CountsJob {
+            seq, iteration: seq as usize, reason: Reason::Every, token: None, ncells: model.voxels.ncells, ngenes: 8,
+            counts: model.params.live_gene_counts(true, false, None), path, name, place, extract_ms: 0.5,
+        }
+    }
