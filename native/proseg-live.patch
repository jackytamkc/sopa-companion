+// proseg-live: per-iteration snapshots for a live viewer, and pause / single-step / speed control polled between
+// iterations. Everything here runs on the main thread between sampler calls, when every Rayon task has joined, so a
+// snapshot is always a consistent state. Snapshots never touch the sampler's RNG or mutate its data structures.
+//
+// Directory layout (written by this module):
+//   info.json            once, before the first frame: schedule, counts, geometry and file layout
+//   cells.txt            once: line k is the original (Xenium) id of internal cell k, i.e. label k + 1
+//   frames/NNNNNN.bin.zst one per snapshot: zstd (level 1) of little-endian u32 arrays, back to back:
+//                          consensus[ny*nx]      transcript-weighted z projection (label = cell + 1, 0 = background)
+//                          last_change[ny*nx]    iteration at which that column's consensus label last changed (0 = never)
+//                          layers[nl*ny*nx]      labels of every z layer, layer-major
+//   frames/NNNNNN.cells.zst per-cell statistics of that snapshot, u32 LE arrays of ncells each (cell = label - 1):
+//                          area (2-D columns), voxels (3-D), assigned transcripts, non-background transcripts,
+//                          changed (2-D columns gained or lost since the previous snapshot), centroid x, y (f32 µm)
+//   frames.jsonl         one line per snapshot, appended after its frame file is in place (the commit point)
+//   transcripts.bin.gz   once: every modelled transcript as little-endian (x f32, y f32, z f32, gene u32); x/y in the
+//                        input micrometre frame, z as proseg normalises it (tilt removed, 1-99% quantiles -> 0..1)
+//   genes.txt            once: gene names, line g names gene index g
+//   sampling_done        created when the last sampler iteration has finished (outputs are written afterwards)
+//   schedule_done        --live-hold: {"iter", "seq"} of the schedule's last iteration, written (after the "paused"
+//                        ack) when proseg completes its schedule and holds there instead of finishing
+//   ack                  {"state": running|paused|finishing, "iter", "seq"}: what proseg is doing now. "paused" and
+//                        "finishing" are written only after every queued frame is committed, so "seq" is exactly the
+//                        state on screen that a finish will save.
+//
+// Tiled mode (--live-tiled, for regions too large for dense per-layer rasters, up to a whole sample):
+//   frames/NNNNNN.tiles  instead of .bin.zst: "PLT1", u32 LE header length, JSON header {nx, ny, nz, tile, tiles_x,
+//                        tiles_y, planes: ["consensus", "last_change"], window: null | {i0, j0, nx, ny, nz}}, then an
+//                        index of (u64 offset, u32 length) LE entries: tiles_y * tiles_x * planes (row-major tiles, plane
+//                        fastest) and one last entry for the window, then the blobs. Each blob is zstd (level 1) of u32
+//                        LE: a tile is the raster rectangle [tx*tile, min((tx+1)*tile, nx)) x [ty*tile, ...) row-major;
+//                        the window is layers[nz][ny][nx] of the window rectangle (raster-relative). Length 0 = all zero.
+//                        The window is the part of the tissue the viewer shows ("view" control line), at most
+//                        WINDOW_MAX voxels on a side; consensus and last_change always cover the whole grid.
+//   prior.tiles          the prior projected to 2-D (planes "label", "permille"), same container.
+//   window.json + window-N.bin.zst   while paused, a moved view gets its per-layer labels for the paused state:
+//                        {seq, iter, i0, j0, nx, ny, nz, file, view} (zstd u32 layers[nz][ny][nx]).
+//   Snapshots are taken only while their extraction costs at most a third of the sampler's time (and the writer is
+//   keeping up), so a whole-sample run is not slowed down by its own display.
+//
+// Proseg's own count (--live-counts request|every; nothing of it without the flag): per cell and gene, n (assigned:
+// transcripts whose cell after drift it is), e (averaged: n split by the background model's foreground probability, i.e.
+// the sampled count averaged over its random draw, with the frame's parameters) and f (sampled: the draw itself, the
+// saved X at the end). A second writer thread writes them, so frames.jsonl and the frame files are unchanged:
+//   counts.jsonl         one line per counted frame, appended once its files are in place (the commit point):
+//                        {seq, iter, file, counted_file, reason, token, where, nnz, sum_n, sum_e, sum_f, has_f,
+//                        has_start, saturated, bytes, ms: {extract, write}}. A frame is counted once, but for two
+//                        re-counts from the same snapshot, each with f and the start block: a pause that reaches a
+//                        frame counted without f counts it again where pause counts go (the spool's file of that name
+//                        is replaced), and a hold, finish or end that reaches a frame whose count is not durable (in
+//                        frames/, with f) counts it again into frames/. The newest line of a seq wins.
+//   NNNNNN.counts.zst    "PLC1", zstd (level 1) of little-endian fields: "PLC1", u32 version (1), ncells, ngenes, nnz,
+//                        flags (bit 0: f; bit 1: genes as u32, when ngenes > 65,535; bit 2: start block), e_scale (32),
+//                        iteration, saturated (values clipped at 65,535); u32 indptr[ncells + 1] (row = cell); genes
+//                        per row ascending, the first absolute, then the step from the previous (u16, u32 with bit 1);
+//                        u16 n[nnz]; u16 e[nnz] (e x 32 rounded half up); u16 f[nnz] (bit 0); with bit 2, u32
+//                        start_nnz and u16 start_e[start_nnz]: e of the assignment at the init frame, with this
+//                        frame's parameters, on the init frame's pattern (--live-counts-start).
+//                        In frames/ for the init, upscale, hold, finish and end states; in --live-counts-dir (else
+//                        frames/) for request, every and pause frames, or in frames/ when that folder cannot take one
+//                        (full, or gone: the line names the file where it is).
+//   frames/NNNNNN.counted.zst  zstd (level 1) of f32 LE per cell: the sum of its stored e / 32.
+//   where-N.bin.zst + where.json  the export a "where" token asks for: every pooled transcript entry observed in the
+//                        box, zstd (level 1) of LE arrays u32 count, u32 i[count], u32 j[count], u8 k[count], u32
+//                        gene[count], u32 dest[count] (the label holding it now, 0 = none), u32 n[count]; where.json
+//                        describes the newest and is written after it (its commit point). Served at once while paused
+//                        or held, else with the next counted frame (from its snapshot). The 4 newest are kept.
+//
+// History thinning keeps disk use bounded in open-ended runs: every iteration up to 2,000 gets a frame, then every
+// 5th up to 10,000, every 25th up to 50,000 and every 100th after that. The state at a pause, a finish and the end of
+// sampling always gets a frame, so what the user inspects and saves is always on screen.
+//
+// Control file lines: "paused 0|1", "step N" (one iteration per new token while paused), "min_ms M" (pace),
+// "finish 0|1" (leave the sampling loop at the next iteration boundary, even when paused, and write the outputs),
+// "continue 0|1" (--live-hold: leave the hold at the end of the schedule and sample on; "paused" and "step" apply
+// from there, and nothing else ends the hold but "finish").
+// "set <flag> <value>" changes a live knob at the next permitted iteration; unknown/malformed settings are ignored.
+// "view x0 y0 x1 y1" (µm): the window tiled frames carry per-layer labels for.
+// "counts N" (--live-counts): a token; a new one gets the next frame counted, even one thinning or the tiled cadence
+// would skip, unless the counts writer is busy (the token then waits for a later frame). "where N x0 y0 x1 y1" (µm):
+// a token for a where export of that box (with the next counted frame, which it also asks for). Tokens read while
+// paused or held are served by the paused state: no frame is forced for them on resuming.
+// A control file that cannot be read (missing for a moment while it is replaced, or empty) keeps the lines last read.
+
+use crate::sampler::transcripts::TranscriptDataset;
+use crate::sampler::voxelcheckerboard::{LiveTiled, LiveWhere, LiveWindow, VoxelCheckerboard};
+use crate::sampler::{LiveGeneCounts, LiveStartCounts, ModelParams};
+use rayon::prelude::*;
+use flate2::Compression;
+use flate2::write::GzEncoder;
+use serde_json::{Value, json};
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufWriter, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{SyncSender, TrySendError, sync_channel};
+use std::sync::{Arc, Mutex};
+use std::thread::{JoinHandle, sleep};
+use std::time::{Duration, Instant};
+
+/// Tile edge (raster columns/rows) of tiled frames, and the largest window side (voxels) they carry layers for.
+pub const TILE: usize = 512;
+pub const WINDOW_MAX: usize = 1600;
+/// Tiled snapshots may use at most this fraction of the wall time between them.
+const TILED_BUDGET: f64 = 0.33;
+
+enum Job {
+    Dense(FrameJob),
+    Tiled(TiledJob),
+}
+
+/// A tiled snapshot: change tracking, tiling, compression and statistics all happen on the writer thread.
+struct TiledJob {
+    seq: u64,
+    record: Value,
+    snap: LiveTiled,
+    ncells: usize,
+    assigned: Vec<u32>,
+    foreground: Vec<u32>,
+    iteration: u32,
+}
+
+/// A snapshot handed to the writer thread: compression and I/O overlap the next sampler iteration.
+struct FrameJob {
+    seq: u64,
+    payload: Vec<u32>,
+    record: Value,
+    // Per-cell statistics: the writer thread derives areas, voxel counts and centroids from the payload.
+    ncells: usize,
+    geometry: (usize, usize, usize, f32, f32, f32), // nx, ny, nz, x0, y0, voxel
+    assigned: Vec<u32>,
+    foreground: Vec<u32>,
+    changed: Vec<u32>,
+}
+
+/// area, voxels, assigned, foreground, changed (u32) and centroid x, y (f32), each ncells long, as LE bytes.
+fn cell_statistics(job: &FrameJob) -> Vec<u8> {
+    let (nx, ny, nz, x0, y0, voxel) = job.geometry;
+    let n = job.ncells;
+    let plane = nx * ny;
+    let mut area = vec![0u32; n + 1];
+    let mut sx = vec![0f64; n + 1];
+    let mut sy = vec![0f64; n + 1];
+    for (p, &label) in job.payload[..plane].iter().enumerate() {
+        if label != 0 && (label as usize) <= n {
+            area[label as usize] += 1;
+            sx[label as usize] += (p % nx) as f64;
+            sy[label as usize] += (p / nx) as f64;
+        }
+    }
+    let mut voxels = vec![0u32; n + 1];
+    for &label in &job.payload[2 * plane..(2 + nz) * plane] {
+        if label != 0 && (label as usize) <= n {
+            voxels[label as usize] += 1;
+        }
+    }
+    let get = |v: &Vec<u32>, c: usize| v.get(c).copied().unwrap_or(0);
+    let mut bytes = Vec::with_capacity(7 * 4 * n);
+    for c in 1..=n {
+        bytes.extend_from_slice(&area[c].to_le_bytes());
+    }
+    for c in 1..=n {
+        bytes.extend_from_slice(&voxels[c].to_le_bytes());
+    }
+    for c in 0..n {
+        bytes.extend_from_slice(&get(&job.assigned, c).to_le_bytes());
+    }
+    for c in 0..n {
+        bytes.extend_from_slice(&get(&job.foreground, c).to_le_bytes());
+    }
+    for c in 1..=n {
+        bytes.extend_from_slice(&get(&job.changed, c).to_le_bytes());
+    }
+    for (sums, origin) in [(&sx, x0), (&sy, y0)] {
+        for c in 1..=n {
+            let centre = if area[c] > 0 {
+                origin + ((sums[c] / area[c] as f64) as f32 + 0.5) * voxel
+            } else {
+                f32::NAN
+            };
+            bytes.extend_from_slice(&centre.to_le_bytes());
+        }
+    }
+    bytes
+}
+
+/// One writer thread keeps frames in order; the bounded queue applies back-pressure if storage falls behind.
+fn spawn_writer(dir: PathBuf, committed: Arc<AtomicU64>) -> (SyncSender<Job>, JoinHandle<()>) {
+    let (sender, receiver) = sync_channel::<Job>(2);
+    let worker = std::thread::Builder::new()
+        .name("proseg-live-writer".into())
+        .spawn(move || {
+            let mut index = OpenOptions::new()
+                .append(true)
+                .open(dir.join("frames.jsonl"))
+                .expect("proseg-live: cannot open frames.jsonl");
+            let mut bytes: Vec<u8> = Vec::with_capacity(1 << 18);
+            let mut tracker: Option<ChangeTracker> = None;
+            for job in receiver {
+                let t = Instant::now();
+                let (seq, mut record) = match job {
+                    Job::Dense(job) => write_dense(&dir, job, &mut bytes),
+                    Job::Tiled(job) => {
+                        let tracker = tracker.get_or_insert_with(|| ChangeTracker::new(job.ncells));
+                        write_tiled(&dir, job, tracker)
+                    }
+                };
+                record["ms"]["write"] = json!(t.elapsed().as_secs_f64() * 1e3);
+                // The index line is the commit point: it is appended only once the frame file is in place.
+                let mut line = serde_json::to_vec(&record).unwrap();
+                line.push(b'\n');
+                index.write_all(&line).expect("proseg-live: cannot append to frames.jsonl");
+                committed.store(seq + 1, Ordering::Release);
+            }
+        })
+        .expect("proseg-live: cannot start the frame writer");
+    (sender, worker)
+}
+
+fn write_dense(dir: &Path, mut job: FrameJob, bytes: &mut Vec<u8>) -> (u64, Value) {
+    // zstd: 2.5x smaller and ~4x faster than gzip on label rasters; browsers inflate it natively.
+    let name = format!("frames/{:06}.bin.zst", job.seq);
+    let tmp = dir.join(format!("frames/.{:06}.tmp", job.seq));
+    {
+        let file = File::create(&tmp).expect("proseg-live: cannot write a frame");
+        let mut encoder = zstd::stream::write::Encoder::new(BufWriter::with_capacity(1 << 20, file), 1)
+            .expect("proseg-live: cannot start a frame");
+        for chunk in job.payload.chunks(1 << 16) {
+            bytes.clear();
+            for &value in chunk {
+                bytes.extend_from_slice(&value.to_le_bytes());
+            }
+            encoder.write_all(bytes).expect("proseg-live: cannot write a frame");
+        }
+        encoder
+            .finish()
+            .and_then(|mut w| w.flush())
+            .expect("proseg-live: cannot write a frame");
+    }
+    fs::rename(&tmp, dir.join(&name)).expect("proseg-live: cannot publish a frame");
+    let stats_name = format!("frames/{:06}.cells.zst", job.seq);
+    let stats = zstd::bulk::compress(&cell_statistics(&job), 1).expect("proseg-live: cannot compress cell statistics");
+    atomic_write(&dir.join(&stats_name), &stats).expect("proseg-live: cannot write cell statistics");
+    job.record["file"] = json!(name);
+    job.record["cells_file"] = json!(stats_name);
+    (job.seq, job.record)
+}
+
+/// Why a frame was counted (counts.jsonl "reason"), in precedence order: when several apply to one state, the first.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Reason {
+    Init,
+    Upscale,
+    Hold,
+    Finish,
+    End,
+    Pause,
+    Request,
+    Every,
+}
+
+impl Reason {
+    fn name(self) -> &'static str {
+        match self {
+            Reason::Init => "init",
+            Reason::Upscale => "upscale",
+            Reason::Hold => "hold",
+            Reason::Finish => "finish",
+            Reason::End => "end",
+            Reason::Pause => "pause",
+            Reason::Request => "request",
+            Reason::Every => "every",
+        }
+    }
+
+    /// The states proseg starts from, refines, pauses, holds, finishes or ends on: they carry f and the start block,
+    /// and may wait for the counts writer (the sampler is not running).
+    fn forced(self) -> bool {
+        !matches!(self, Reason::Request | Reason::Every)
+    }
+
+    /// Kept in frames/ (else in --live-counts-dir).
+    fn durable(self) -> bool {
+        matches!(self, Reason::Init | Reason::Upscale | Reason::Hold | Reason::Finish | Reason::End)
+    }
+}
+
+/// --live-counts: what counted frames carry and where their files go.
+pub struct CountsOptions {
+    /// "every" (every frame counted, with f), else "request".
+    pub every: bool,
+    /// --live-counts-dir: request, every and pause counts (else frames/).
+    pub spool: Option<PathBuf>,
+    /// --live-counts-start K: the start block with every forced frame and every K-th counted frame.
+    pub start_every: Option<u64>,
+    /// As the model's background split: frozen cells keep all their transcripts.
+    pub unmodeled_fixed_cells: bool,
+}
+
+/// A "where N x0 y0 x1 y1" token and its box (µm).
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct WhereAsk {
+    token: u64,
+    bx: [f32; 4],
+}
+
+/// A where export: its description (where.json, W) and its records.
+struct WhereExport {
+    meta: Value,
+    found: LiveWhere,
+}
+
+/// A counted frame handed to the counts writer.
+struct CountsJob {
+    seq: u64,
+    iteration: usize,
+    reason: Reason,
+    token: Option<u64>,
+    ncells: usize,
+    ngenes: usize,
+    counts: LiveGeneCounts,
+    /// The count file, and its name in the line (relative to the live folder in frames/, else absolute).
+    path: PathBuf,
+    name: String,
+    place: Option<WhereExport>,
+    extract_ms: f64,
+}
+
+/// The newest counted frame: whether its count has f (a pause there needs no second count) and whether it is durable
+/// (in frames/, with f: a hold, finish or end there needs none).
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Counted {
+    seq: u64,
+    sampled: bool,
+    durable: bool,
+}
+
+/// --live-counts state: the counts writer, the control file's tokens and what has been counted.
+struct Counts {
+    options: CountsOptions,
+    sender: Option<SyncSender<CountsJob>>,
+    worker: Option<JoinHandle<()>>,
+    queued: u64,
+    written: Arc<AtomicU64>,
+    asked: u64,
+    asked_where: Option<WhereAsk>,
+    served: u64,
+    served_where: u64,
+    last: Option<Counted>,
+    /// Frames counted so far (--live-counts-start K takes the start block with every K-th).
+    ordinal: u64,
+    start: Option<LiveStartCounts>,
+    /// Where tokens whose files are on disk, oldest first.
+    wheres: Arc<Mutex<Vec<u64>>>,
+}
+
+impl Counts {
+    fn pending(&self) -> bool {
+        self.asked > self.served || self.asked_where.is_some_and(|w| w.token > self.served_where)
+    }
+
+    /// Nothing queued or being written.
+    fn idle(&self) -> bool {
+        self.written.load(Ordering::Acquire) >= self.queued
+    }
+}
+
+/// The where export's margin (µm): proseg scans the quads within it of the box. Transcripts drift a few
+/// diffusion-sigma-far at most in practice.
+fn where_margin(sigma_far: f64) -> f64 {
+    (6.0 * sigma_far).max(20.0)
+}
+
+/// W: a where export's description (where.json, and a counts line's "where").
+fn where_meta(ask: WhereAsk, seq: u64, iteration: usize, margin_um: f64, found: &LiveWhere) -> Value {
+    let g = &found.geometry;
+    json!({
+        "token": ask.token, "seq": seq, "iter": iteration, "box": ask.bx, "margin_um": margin_um,
+        "x0": g.x0, "y0": g.y0, "voxel": g.voxelsize, "nx": g.nx, "ny": g.ny, "nz": g.nlayers,
+        "i0": found.i0, "j0": found.j0, "i1": found.i1, "j1": found.j1,
+        "file": format!("where-{}.bin.zst", ask.token), "entries": found.i.len(),
+    })
+}
+
+/// A where export's records, uncompressed (layout in the header comment).
+fn where_bytes(found: &LiveWhere) -> Vec<u8> {
+    let count = found.i.len();
+    let mut bytes = Vec::with_capacity(4 + 21 * count);
+    bytes.extend_from_slice(&(count as u32).to_le_bytes());
+    for values in [&found.i, &found.j] {
+        bytes.extend(values.iter().flat_map(|v| v.to_le_bytes()));
+    }
+    bytes.extend_from_slice(&found.k);
+    for values in [&found.gene, &found.dest, &found.n] {
+        bytes.extend(values.iter().flat_map(|v| v.to_le_bytes()));
+    }
+    bytes
+}
+
+/// Publish a where export: its records, then where.json (the commit point); the 4 newest exports are kept.
+fn write_where(dir: &Path, export: &WhereExport, kept: &Mutex<Vec<u64>>) {
+    let token = export.meta["token"].as_u64().unwrap();
+    let packed = zstd::bulk::compress(&where_bytes(&export.found), 1).expect("proseg-live: cannot compress a where export");
+    atomic_write(&dir.join(format!("where-{token}.bin.zst")), &packed).expect("proseg-live: cannot write a where export");
+    atomic_write(&dir.join("where.json"), &serde_json::to_vec(&export.meta).unwrap())
+        .expect("proseg-live: cannot write where.json");
+    let mut kept = kept.lock().unwrap();
+    kept.retain(|&t| t != token);
+    kept.push(token);
+    while kept.len() > 4 {
+        let old = kept.remove(0);
+        let _ = fs::remove_file(dir.join(format!("where-{old}.bin.zst")));
+    }
+}
+
+/// PLC1, before compression (layout in the header comment).
+fn plc1(ncells: usize, ngenes: usize, iteration: usize, counts: &LiveGeneCounts) -> Vec<u8> {
+    let nnz = counts.genes.len();
+    assert_eq!(counts.indptr.len(), ncells + 1, "proseg-live: counts of another number of cells");
+    let wide = ngenes > u16::MAX as usize;
+    let flags = counts.f.is_some() as u32 | (wide as u32) << 1 | (counts.start.is_some() as u32) << 2;
+    let start_nnz = counts.start.as_ref().map_or(0, Vec::len);
+    let mut bytes = Vec::with_capacity(36 + 4 * (ncells + 1) + nnz * (if wide { 4 } else { 2 } + 6) + 4 + 2 * start_nnz);
+    bytes.extend_from_slice(b"PLC1");
+    for value in [1, ncells as u32, ngenes as u32, nnz as u32, flags, 32, iteration as u32,
+                  counts.saturated.min(u32::MAX as u64) as u32] {
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    bytes.extend(counts.indptr.iter().flat_map(|v| v.to_le_bytes()));
+    for row in counts.indptr.windows(2) {
+        let mut previous = 0;
+        for (k, &gene) in counts.genes[row[0] as usize..row[1] as usize].iter().enumerate() {
+            let step = if k == 0 { gene } else { gene - previous };
+            previous = gene;
+            if wide {
+                bytes.extend_from_slice(&step.to_le_bytes());
+            } else {
+                bytes.extend_from_slice(&(step as u16).to_le_bytes());
+            }
+        }
+    }
+    for values in [Some(&counts.n), Some(&counts.e), counts.f.as_ref()].into_iter().flatten() {
+        bytes.extend(values.iter().flat_map(|v| v.to_le_bytes()));
+    }
+    if let Some(start) = &counts.start {
+        bytes.extend_from_slice(&(start.len() as u32).to_le_bytes());
+        bytes.extend(start.iter().flat_map(|v| v.to_le_bytes()));
+    }
+    bytes
+}
+
+/// The per-cell sidecar (frames/NNNNNN.counted.zst), before compression: f32 LE per cell, its stored e summed / 32.
+fn counted_bytes(counts: &LiveGeneCounts) -> Vec<u8> {
+    counts
+        .indptr
+        .windows(2)
+        .flat_map(|row| {
+            let sum: u64 = counts.e[row[0] as usize..row[1] as usize].iter().map(|&e| e as u64).sum();
+            ((sum as f64 / 32.0) as f32).to_le_bytes()
+        })
+        .collect()
+}
+
+/// The counts writer: its own thread and queue (sync_channel(1)), so a large count file never holds a frame in
+/// flight. Each job: the count file, the sidecar, its where export if any, then its counts.jsonl line (the commit
+/// point); `written` counts the lines.
+fn spawn_counts_writer(
+    dir: PathBuf,
+    written: Arc<AtomicU64>,
+    wheres: Arc<Mutex<Vec<u64>>>,
+) -> (SyncSender<CountsJob>, JoinHandle<()>) {
+    let (sender, receiver) = sync_channel::<CountsJob>(1);
+    let worker = std::thread::Builder::new()
+        .name("proseg-live-counts".into())
+        .spawn(move || {
+            let mut index = OpenOptions::new()
+                .append(true)
+                .open(dir.join("counts.jsonl"))
+                .expect("proseg-live: cannot open counts.jsonl");
+            for job in receiver {
+                let t = Instant::now();
+                let mut line = write_counts(&dir, &job, &wheres);
+                line["ms"]["write"] = json!(t.elapsed().as_secs_f64() * 1e3);
+                let mut text = serde_json::to_vec(&line).unwrap();
+                text.push(b'\n');
+                index.write_all(&text).expect("proseg-live: cannot append to counts.jsonl");
+                written.fetch_add(1, Ordering::AcqRel);
+            }
+        })
+        .expect("proseg-live: cannot start the counts writer");
+    (sender, worker)
+}
+
+/// One counted frame's files, in commit order; returns its counts.jsonl line (without "ms.write"). A count file the
+/// spool cannot take (full, or gone) goes to frames/ instead, so that a full spool never ends the run; any other write
+/// that fails stops the counts writer, and with it the run, as a frame that cannot be written does.
+fn write_counts(dir: &Path, job: &CountsJob, wheres: &Mutex<Vec<u64>>) -> Value {
+    let counts = &job.counts;
+    let packed = zstd::bulk::compress(&plc1(job.ncells, job.ngenes, job.iteration, counts), 1)
+        .expect("proseg-live: cannot compress counts");
+    let durable = format!("frames/{:06}.counts.zst", job.seq);
+    let name = match atomic_write(&job.path, &packed) {
+        Ok(()) => job.name.clone(),
+        Err(error) if job.name != durable => {
+            eprintln!("proseg-live: cannot write {} ({error}); written to {durable} instead", job.path.display());
+            atomic_write(&dir.join(&durable), &packed).expect("proseg-live: cannot write counts");
+            durable
+        }
+        Err(error) => panic!("proseg-live: cannot write counts: {error}"),
+    };
+    let counted_name = format!("frames/{:06}.counted.zst", job.seq);
+    let counted = zstd::bulk::compress(&counted_bytes(counts), 1).expect("proseg-live: cannot compress counts");
+    atomic_write(&dir.join(&counted_name), &counted).expect("proseg-live: cannot write counts");
+    if let Some(export) = &job.place {
+        write_where(dir, export, wheres);
+    }
+    let sum = |values: &[u16]| values.iter().map(|&v| v as u64).sum::<u64>();
+    json!({
+        "seq": job.seq, "iter": job.iteration, "file": name, "counted_file": counted_name,
+        "reason": job.reason.name(), "token": job.token, "where": job.place.as_ref().map(|export| &export.meta),
+        "nnz": counts.genes.len(), "sum_n": sum(&counts.n), "sum_e": sum(&counts.e) as f64 / 32.0,
+        "sum_f": counts.f.as_deref().map(sum), "has_f": counts.f.is_some(), "has_start": counts.start.is_some(),
+        "saturated": counts.saturated, "bytes": packed.len(), "ms": {"extract": job.extract_ms, "write": null},
+    })
+}
+
+fn le_bytes(values: &[u32]) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(values.len() * 4);
+    for &value in values {
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    bytes
+}
+
+/// The tile container (layout in the header comment). `planes` are full rasters of nx * ny; `window` an optional
+/// extra blob (already laid out) whose description goes in the header.
+fn write_container(path: &Path, nx: usize, ny: usize, nz: usize, names: &[&str], planes: &[&[u32]], window: Option<(Value, &[u32])>) {
+    let tiles_x = nx.div_ceil(TILE).max(1);
+    let tiles_y = ny.div_ceil(TILE).max(1);
+    let jobs: Vec<(usize, usize, usize)> = (0..tiles_y)
+        .flat_map(|ty| (0..tiles_x).flat_map(move |tx| (0..planes.len()).map(move |plane| (ty, tx, plane))))
+        .collect();
+    let mut blobs: Vec<Vec<u8>> = jobs
+        .par_iter()
+        .map(|&(ty, tx, plane)| {
+            let (x0, x1) = (tx * TILE, ((tx + 1) * TILE).min(nx));
+            let (y0, y1) = (ty * TILE, ((ty + 1) * TILE).min(ny));
+            let source = planes[plane];
+            if (y0..y1).all(|y| source[y * nx + x0..y * nx + x1].iter().all(|&v| v == 0)) {
+                return Vec::new();
+            }
+            let mut tile = Vec::with_capacity((x1 - x0) * (y1 - y0) * 4);
+            for y in y0..y1 {
+                for &value in &source[y * nx + x0..y * nx + x1] {
+                    tile.extend_from_slice(&value.to_le_bytes());
+                }
+            }
+            zstd::bulk::compress(&tile, 1).expect("proseg-live: cannot compress a tile")
+        })
+        .collect();
+    let window_info = match &window {
+        Some((info, layers)) => {
+            blobs.push(if layers.iter().all(|&v| v == 0) {
+                Vec::new()
+            } else {
+                zstd::bulk::compress(&le_bytes(layers), 1).expect("proseg-live: cannot compress the window")
+            });
+            info.clone()
+        }
+        None => {
+            blobs.push(Vec::new());
+            Value::Null
+        }
+    };
+    let header = serde_json::to_vec(&json!({
+        "nx": nx, "ny": ny, "nz": nz, "tile": TILE, "tiles_x": tiles_x, "tiles_y": tiles_y,
+        "planes": names, "window": window_info,
+    }))
+    .unwrap();
+    let mut offset = (8 + header.len() + blobs.len() * 12) as u64;
+    let mut head = Vec::with_capacity(8 + header.len() + blobs.len() * 12);
+    head.extend_from_slice(b"PLT1");
+    head.extend_from_slice(&(header.len() as u32).to_le_bytes());
+    head.extend_from_slice(&header);
+    for blob in &blobs {
+        head.extend_from_slice(&offset.to_le_bytes());
+        head.extend_from_slice(&(blob.len() as u32).to_le_bytes());
+        offset += blob.len() as u64;
+    }
+    let tmp = path.with_file_name(format!(".{}.tmp", path.file_name().unwrap().to_string_lossy()));
+    {
+        let mut file = BufWriter::with_capacity(1 << 22, File::create(&tmp).expect("proseg-live: cannot write a tiled frame"));
+        file.write_all(&head).expect("proseg-live: cannot write a tiled frame");
+        for blob in &blobs {
+            file.write_all(blob).expect("proseg-live: cannot write a tiled frame");
+        }
+        file.flush().expect("proseg-live: cannot write a tiled frame");
+    }
+    fs::rename(&tmp, path).expect("proseg-live: cannot publish a tiled frame");
+}
+
+fn write_tiled(dir: &Path, job: TiledJob, tracker: &mut ChangeTracker) -> (u64, Value) {
+    let TiledJob { seq, mut record, snap, ncells, assigned, foreground, iteration } = job;
+    let (changed, changed_cells) = tracker.track(snap.nx, snap.ny, snap.i0, snap.j0, snap.voxelsize, &snap.consensus, iteration);
+    let name = format!("frames/{:06}.tiles", seq);
+    let window = snap.window.as_ref().map(|w| {
+        (json!({"i0": w.i0, "j0": w.j0, "nx": w.nx, "ny": w.ny, "nz": snap.nlayers}), w.layers.as_slice())
+    });
+    write_container(
+        &dir.join(&name),
+        snap.nx,
+        snap.ny,
+        snap.nlayers,
+        &["consensus", "last_change"],
+        &[&snap.consensus, &tracker.last_change],
+        window,
+    );
+    // Per-cell statistics, as for dense frames (the voxel counts come from the quad pass).
+    let n = ncells;
+    let mut area = vec![0u32; n + 1];
+    let mut sx = vec![0f64; n + 1];
+    let mut sy = vec![0f64; n + 1];
+    for (row, labels) in snap.consensus.chunks(snap.nx.max(1)).enumerate() {
+        for (x, &label) in labels.iter().enumerate() {
+            if label != 0 && (label as usize) <= n {
+                area[label as usize] += 1;
+                sx[label as usize] += x as f64;
+                sy[label as usize] += row as f64;
+            }
+        }
+    }
+    let get = |v: &Vec<u32>, c: usize| v.get(c).copied().unwrap_or(0);
+    let mut bytes = Vec::with_capacity(7 * 4 * n);
+    for c in 1..=n {
+        bytes.extend_from_slice(&area[c].to_le_bytes());
+    }
+    for c in 1..=n {
+        bytes.extend_from_slice(&get(&snap.voxels, c).to_le_bytes());
+    }
+    for c in 0..n {
+        bytes.extend_from_slice(&get(&assigned, c).to_le_bytes());
+    }
+    for c in 0..n {
+        bytes.extend_from_slice(&get(&foreground, c).to_le_bytes());
+    }
+    for c in 1..=n {
+        bytes.extend_from_slice(&get(&changed_cells, c).to_le_bytes());
+    }
+    for (sums, origin) in [(&sx, snap.x0), (&sy, snap.y0)] {
+        for c in 1..=n {
+            let centre = if area[c] > 0 {
+                origin + ((sums[c] / area[c] as f64) as f32 + 0.5) * snap.voxelsize
+            } else {
+                f32::NAN
+            };
+            bytes.extend_from_slice(&centre.to_le_bytes());
+        }
+    }
+    let stats_name = format!("frames/{:06}.cells.zst", seq);
+    let stats = zstd::bulk::compress(&bytes, 1).expect("proseg-live: cannot compress cell statistics");
+    atomic_write(&dir.join(&stats_name), &stats).expect("proseg-live: cannot write cell statistics");
+    record["file"] = json!(name);
+    record["cells_file"] = json!(stats_name);
+    record["changed"] = json!(changed);
+    record["visible"] = json!(area.iter().skip(1).filter(|&&a| a > 0).count());
+    tracker.remember(snap.nx, snap.ny, snap.i0, snap.j0, snap.voxelsize, snap.consensus);
+    (seq, record)
+}
+
+/// The per-column "last changed at" raster, carried from frame to frame and across a resolution increase.
+struct ChangeTracker {
+    previous: Option<Previous>,
+    last_change: Vec<u32>,
+    ncells: usize,
+}
+
+impl ChangeTracker {
+    fn new(ncells: usize) -> ChangeTracker {
+        ChangeTracker { previous: None, last_change: Vec::new(), ncells }
+    }
+
+    /// Update `last_change` against the previous frame (each old column becomes an r x r block after a resolution
+    /// increase). Returns how many columns changed label, and per label how many of its columns changed.
+    #[allow(clippy::too_many_arguments)]
+    fn track(&mut self, nx: usize, ny: usize, i0: i32, j0: i32, voxelsize: f32, consensus: &[u32], iteration: u32) -> (u64, Vec<u32>) {
+        let stamp = iteration.max(1);
+        let plane = nx * ny;
+        let mut per_cell = vec![0u32; self.ncells + 1];
+        let Some(previous) = &self.previous else {
+            self.last_change = vec![0; plane];
+            return (0, per_cell);
+        };
+        let mut changed = 0u64;
+        let count = |old: u32, new: u32, per_cell: &mut Vec<u32>| {
+            for label in [old, new] {
+                if let Some(slot) = per_cell.get_mut(label as usize) {
+                    if label != 0 {
+                        *slot += 1;
+                    }
+                }
+            }
+        };
+        if previous.nx == nx && previous.ny == ny && previous.i0 == i0 && previous.j0 == j0 {
+            for p in 0..plane {
+                if consensus[p] != previous.consensus[p] {
+                    self.last_change[p] = stamp;
+                    changed += 1;
+                    count(previous.consensus[p], consensus[p], &mut per_cell);
+                }
+            }
+            return (changed, per_cell);
+        }
+        let ratio = previous.voxelsize / voxelsize;
+        let r = ratio.round() as i32;
+        if r >= 1 && (ratio - r as f32).abs() < 1e-4 {
+            let mut last_change = vec![0u32; plane];
+            for y in 0..ny {
+                let oy = (j0 + y as i32).div_euclid(r) - previous.j0;
+                for x in 0..nx {
+                    let ox = (i0 + x as i32).div_euclid(r) - previous.i0;
+                    let p = y * nx + x;
+                    let old = if ox >= 0 && oy >= 0 && (ox as usize) < previous.nx && (oy as usize) < previous.ny {
+                        let q = oy as usize * previous.nx + ox as usize;
+                        last_change[p] = self.last_change[q];
+                        previous.consensus[q]
+                    } else {
+                        0
+                    };
+                    if consensus[p] != old {
+                        last_change[p] = stamp;
+                        changed += 1;
+                        count(old, consensus[p], &mut per_cell);
+                    }
+                }
+            }
+            self.last_change = last_change;
+        } else {
+            self.last_change = vec![0; plane];
+        }
+        (changed, per_cell)
+    }
+
+    fn remember(&mut self, nx: usize, ny: usize, i0: i32, j0: i32, voxelsize: f32, consensus: Vec<u32>) {
+        self.previous = Some(Previous { nx, ny, i0, j0, voxelsize, consensus });
+    }
+}
+
+/// Statistics of one completed iteration; `None` where the value is not meaningful for that snapshot.
+#[derive(Clone, Copy, Default)]
+pub struct IterationStats {
+    pub loglik: Option<f64>,
+    pub nassigned: Option<u64>,
+    pub nforeground: Option<u64>,
+    pub ms_morphology: f64,
+    pub ms_repositioning: f64,
+    pub ms_parameters: f64,
+}
+
+struct Previous {
+    nx: usize,
+    ny: usize,
+    i0: i32,
+    j0: i32,
+    voxelsize: f32,
+    consensus: Vec<u32>,
+}
+
+/// An iteration whose frame was thinned out; emitted after all if the sampler holds or stops on it.
+struct Pending {
+    phase: String,
+    iteration: usize,
+    temperature: f32,
+    stats: IterationStats,
+    nonempty_cells: usize,
+}
+
+/// Step tokens while proseg holds at the end of its schedule (--live-hold): every token issued before the viewer asks
+/// to sample on is spent there (a second click of a double Step that ran the schedule's last iteration must not replay
+/// as an extra iteration once sampling goes on); the token that comes with "continue 1" (Step at the hold) is left for
+/// `wait`, which runs exactly that one iteration.
+fn held_steps(steps_used: u64, step: u64, continued: bool) -> u64 {
+    if continued {
+        steps_used
+    } else {
+        steps_used.max(step)
+    }
+}
+
+/// Frames kept by history thinning (see the header comment).
+fn is_kept(phase: &str, iteration: usize) -> bool {
+    matches!(phase, "init" | "upscale")
+        || iteration <= 2_000
+        || (iteration <= 10_000 && iteration % 5 == 0)
+        || (iteration <= 50_000 && iteration % 25 == 0)
+        || iteration % 100 == 0
+}
+
+#[derive(Clone)]
+struct Control {
+    paused: bool,
+    step: u64,
+    min_ms: u64,
+    finish: bool,
+    continued: bool,
+    settings: serde_json::Map<String, Value>,
+    view: Option<[f32; 4]>,
+    counts: u64,
+    where_: Option<WhereAsk>,
+}
+
+/// "where N x0 y0 x1 y1": a token (a decimal u64 of at least 1) and four finite numbers, x1 > x0 and y1 > y0; anything
+/// else is no where line.
+fn parse_where(token: &str, numbers: &[&str]) -> Option<WhereAsk> {
+    let token = token.parse::<u64>().ok().filter(|&t| t >= 1)?;
+    let [x0, y0, x1, y1] = numbers else {
+        return None;
+    };
+    let mut bx = [0.0_f32; 4];
+    for (slot, text) in bx.iter_mut().zip([x0, y0, x1, y1]) {
+        *slot = text.parse::<f32>().ok().filter(|v| v.is_finite())?;
+    }
+    (bx[2] > bx[0] && bx[3] > bx[1]).then_some(WhereAsk { token, bx })
+}
+
+pub struct LiveWriter {
+    dir: PathBuf,
+    control: Option<PathBuf>,
+    last_control: Option<Control>,
+    seq: u64,
+    started: Instant,
+    last_start: Instant,
+    tracker: ChangeTracker,
+    steps_used: u64,
+    ntranscripts: usize,
+    ncells: usize,
+    pub values: serde_json::Map<String, Value>,
+    pub temperature: Option<f32>,
+    sender: Option<SyncSender<Job>>,
+    worker: Option<JoinHandle<()>>,
+    committed: Arc<AtomicU64>,
+    pending: Option<Pending>,
+    last_iteration: usize,
+    ack: String,
+    tiled: bool,
+    view: Option<[f32; 4]>,
+    window_view: Option<[f32; 4]>,
+    windows: u64,
+    last_emit: Instant,
+    last_extract_ms: f64,
+    counts: Option<Counts>,
+}
+
+fn atomic_write(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let tmp = path.with_file_name(format!(
+        ".{}.tmp",
+        path.file_name().unwrap().to_string_lossy()
+    ));
+    let written = fs::write(&tmp, bytes).and_then(|()| fs::rename(&tmp, path));
+    if written.is_err() {
+        let _ = fs::remove_file(&tmp); // a part written to a full disk is not left there
+    }
+    written
+}
+
+fn finite(value: Option<f64>) -> Value {
+    match value {
+        Some(v) if v.is_finite() => json!(v),
+        _ => Value::Null,
+    }
+}
+
+impl LiveWriter {
+    pub fn new(dir: &str, control: Option<&str>, ntranscripts: usize, ncells: usize, tiled: bool) -> LiveWriter {
+        let dir = PathBuf::from(dir);
+        fs::create_dir_all(dir.join("frames"))
+            .expect("proseg-live: cannot create the snapshot directory");
+        // A fresh index for a fresh run; the frame files it references are rewritten below.
+        File::create(dir.join("frames.jsonl")).expect("proseg-live: cannot create frames.jsonl");
+        let _ = fs::remove_file(dir.join("sampling_done"));
+        let _ = fs::remove_file(dir.join("schedule_done"));
+        let _ = fs::remove_file(dir.join("ack"));
+        let _ = fs::remove_file(dir.join("window.json"));
+        // An earlier run's counts index and where exports (--live-counts makes a fresh index).
+        let _ = fs::remove_file(dir.join("counts.jsonl"));
+        let _ = fs::remove_file(dir.join("where.json"));
+        for entry in fs::read_dir(&dir).into_iter().flatten().flatten() {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name.starts_with("where-") && name.ends_with(".bin.zst") {
+                let _ = fs::remove_file(entry.path());
+            }
+        }
+        let committed = Arc::new(AtomicU64::new(0));
+        let (sender, worker) = spawn_writer(dir.clone(), committed.clone());
+        LiveWriter {
+            sender: Some(sender),
+            worker: Some(worker),
+            committed,
+            pending: None,
+            last_iteration: 0,
+            ack: String::new(),
+            dir,
+            control: control.map(PathBuf::from),
+            last_control: None,
+            seq: 0,
+            started: Instant::now(),
+            last_start: Instant::now(),
+            tracker: ChangeTracker::new(ncells),
+            steps_used: 0,
+            ntranscripts,
+            ncells,
+            values: serde_json::Map::new(),
+            temperature: None,
+            tiled,
+            view: None,
+            window_view: None,
+            windows: 0,
+            last_emit: Instant::now(),
+            last_extract_ms: 0.0,
+            counts: None,
+        }
+    }
+
+    /// --live-counts: count frames (header comment) from here on, with a fresh counts.jsonl and the counts writer.
+    pub fn enable_counts(&mut self, mut options: CountsOptions) {
+        if let Some(spool) = options.spool.take() {
+            fs::create_dir_all(&spool).expect("proseg-live: cannot create the --live-counts-dir folder");
+            options.spool = Some(std::path::absolute(&spool).unwrap_or(spool));
+        }
+        File::create(self.dir.join("counts.jsonl")).expect("proseg-live: cannot create counts.jsonl");
+        let written = Arc::new(AtomicU64::new(0));
+        let wheres = Arc::new(Mutex::new(Vec::new()));
+        let (sender, worker) = spawn_counts_writer(self.dir.clone(), written.clone(), wheres.clone());
+        self.counts = Some(Counts {
+            options,
+            sender: Some(sender),
+            worker: Some(worker),
+            queued: 0,
+            written,
+            asked: 0,
+            asked_where: None,
+            served: 0,
+            served_where: 0,
+            last: None,
+            ordinal: 0,
+            start: None,
+            wheres,
+        });
+    }
+
+    pub fn write_info(&self, mut info: Value, cell_ids: &[String]) {
+        if let Some(counts) = &self.counts {
+            let options = &counts.options;
+            info["counts"] = json!({
+                "mode": if options.every { "every" } else { "request" }, "format": "PLC1", "version": 1, "e_scale": 32,
+                "start": options.start_every.is_some(), "start_every": options.start_every,
+                "spool": options.spool.as_ref().map(|path| path.to_string_lossy()), "where": 1,
+            });
+        }
+        let mut text = String::with_capacity(cell_ids.len() * 12);
+        for id in cell_ids {
+            text.push_str(id);
+            text.push('\n');
+        }
+        atomic_write(&self.dir.join("cells.txt"), text.as_bytes())
+            .expect("proseg-live: cannot write cells.txt");
+        let bytes = serde_json::to_vec_pretty(&info).unwrap();
+        atomic_write(&self.dir.join("info.json"), &bytes)
+            .expect("proseg-live: cannot write info.json");
+    }
+
+    fn read_control(&mut self) -> Control {
+        let mut control = Control {
+            paused: false,
+            step: 0,
+            min_ms: 0,
+            finish: false,
+            continued: false,
+            settings: serde_json::Map::new(),
+            view: None,
+            counts: 0,
+            where_: None,
+        };
+        if let Some(path) = &self.control {
+            // A file that cannot be read now (missing, or empty) keeps the lines last read: replacing it leaves some
+            // disks a moment without it (NTFS through ntfs-3g), and that moment must not read as "running".
+            let text = match fs::read_to_string(path) {
+                Ok(text) if !text.trim().is_empty() => text,
+                _ => return self.last_control.clone().unwrap_or(control),
+            };
+            for line in text.lines() {
+                let mut parts = line.split_whitespace();
+                let (Some(key), Some(value)) = (parts.next(), parts.next()) else {
+                    continue;
+                };
+                if key == "view" {
+                    let numbers: Vec<f32> = std::iter::once(value)
+                        .chain(parts.by_ref())
+                        .filter_map(|v| v.parse::<f32>().ok())
+                        .filter(|v| v.is_finite())
+                        .collect();
+                    if numbers.len() == 4 {
+                        control.view = Some([numbers[0], numbers[1], numbers[2], numbers[3]]);
+                    }
+                    continue;
+                }
+                if key == "where" {
+                    let numbers: Vec<&str> = parts.by_ref().collect();
+                    if let Some(ask) = parse_where(value, &numbers) {
+                        control.where_ = Some(ask);
+                    }
+                    continue;
+                }
+                if key == "counts" {
+                    if let Some(token) = value.parse::<u64>().ok().filter(|&t| t >= 1) {
+                        control.counts = token;
+                    }
+                    continue;
+                }
+                if key == "set" {
+                    if let Some(raw) = parts.next() {
+                        if let Some(v) = parse_setting(value, raw) {
+                            control.settings.insert(value.to_owned(), v);
+                        }
+                    }
+                    continue;
+                }
+                let value: u64 = value.parse().unwrap_or(0);
+                match key {
+                    "paused" => control.paused = value != 0,
+                    "step" => control.step = value,
+                    "min_ms" => control.min_ms = value.min(60_000),
+                    "finish" => control.finish = value != 0,
+                    "continue" => control.continued = value != 0,
+                    _ => {}
+                }
+            }
+            self.last_control = Some(control.clone());
+        }
+        control
+    }
+
+    /// Called before every sampler iteration: hold while paused (one iteration per step token), then pace the
+    /// iteration rate to at most one per `min_ms`, re-reading the control file throughout so a pause or finish takes
+    /// effect at this boundary. Returns false when the viewer asked to finish: stop sampling and write the results
+    /// from the current state, which by then is the last committed frame.
+    pub fn wait(&mut self, voxels: &VoxelCheckerboard, params: &ModelParams) -> bool {
+        let mut stepping = false;
+        loop {
+            self.check_writer();
+            let control = self.read_control();
+            self.take_tokens(&control);
+            self.take_settings(control.settings);
+            self.view = control.view;
+            if control.finish {
+                self.settle(voxels, params, "finishing", Reason::Finish);
+                return false;
+            }
+            if control.paused && !stepping {
+                if control.step > self.steps_used {
+                    self.steps_used += 1;
+                    stepping = true;
+                } else {
+                    self.settle(voxels, params, "paused", Reason::Pause);
+                    self.serve_held(voxels);
+                    if self.tiled {
+                        self.refresh_window(voxels);
+                    }
+                    sleep(Duration::from_millis(40));
+                    continue;
+                }
+            }
+            if !control.paused {
+                // Step tokens issued while running are spent: they must not replay at a later pause.
+                self.steps_used = self.steps_used.max(control.step);
+            }
+            let budget = Duration::from_millis(control.min_ms);
+            let spent = self.last_start.elapsed();
+            if !stepping && spent < budget {
+                sleep((budget - spent).min(Duration::from_millis(40)));
+                continue;
+            }
+            self.set_ack("running");
+            self.last_start = Instant::now();
+            return true;
+        }
+    }
+
+    /// --live-hold, called once when the schedule is complete: commit the final state and acknowledge it as paused,
+    /// publish `schedule_done`, then hold, whatever "paused" says, until the control file asks to continue (true:
+    /// sample on, through `wait`, which applies "paused" and "step" from there) or to finish (false: write the outputs
+    /// from this state). Step tokens issued meanwhile are spent here (`held_steps`).
+    pub fn hold(&mut self, voxels: &VoxelCheckerboard, params: &ModelParams) -> bool {
+        self.settle(voxels, params, "paused", Reason::Hold);
+        let done = format!(
+            "{{\"iter\": {}, \"seq\": {}}}\n",
+            self.last_iteration,
+            self.committed.load(Ordering::Acquire) as i64 - 1
+        );
+        atomic_write(&self.dir.join("schedule_done"), done.as_bytes())
+            .expect("proseg-live: cannot write schedule_done");
+        loop {
+            self.check_writer();
+            let control = self.read_control();
+            self.take_tokens(&control);
+            self.take_settings(control.settings);
+            self.view = control.view;
+            if control.finish {
+                self.settle(voxels, params, "finishing", Reason::Finish);
+                return false;
+            }
+            if control.continued {
+                return true;
+            }
+            self.steps_used = held_steps(self.steps_used, control.step, control.continued);
+            self.serve_held(voxels);
+            if self.tiled {
+                self.refresh_window(voxels);
+            }
+            sleep(Duration::from_millis(40));
+        }
+    }
+
+    /// Make the current state visible and committed (emit a thinned-out frame, drain the writer), then acknowledge.
+    /// With --live-counts the state is counted first (`reason`; once per frame, see `counts_needed`), and the ack waits
+    /// for its counts line too: a "paused" or "finishing" ack implies the state's counts are on disk.
+    fn settle(&mut self, voxels: &VoxelCheckerboard, params: &ModelParams, state: &str, reason: Reason) {
+        if let Some(p) = self.pending.take() {
+            let counted = self.counts.is_some().then_some(reason);
+            self.emit(voxels, params, &p.phase, p.iteration, p.temperature, &p.stats, p.nonempty_cells, counted, false);
+        } else if self.seq > 0 && self.counts_needed(self.seq - 1, reason) {
+            self.count(voxels, params, self.seq - 1, self.last_iteration, reason, false);
+        }
+        self.drain();
+        self.set_ack(state);
+    }
+
+    /// Wait until every queued frame and counts line is committed.
+    fn drain(&self) {
+        while self.committed.load(Ordering::Acquire) < self.seq || !self.counts.as_ref().is_none_or(Counts::idle) {
+            self.check_writer();
+            sleep(Duration::from_millis(2));
+        }
+    }
+
+    fn set_ack(&mut self, state: &str) {
+        // "running" is written on the transition only; "paused"/"finishing" carry the exact committed state.
+        if state == "running" && self.ack.contains("\"running\"") {
+            return;
+        }
+        let text = format!(
+            "{{\"state\": \"{state}\", \"iter\": {}, \"seq\": {}}}\n",
+            self.last_iteration,
+            self.committed.load(Ordering::Acquire) as i64 - 1
+        );
+        if text != self.ack {
+            if atomic_write(&self.dir.join("ack"), text.as_bytes()).is_ok() {
+                self.ack = text;
+            }
+        }
+    }
+
+    /// A writer that died (e.g. disk full) must stop the run visibly, even while paused.
+    fn check_writer(&self) {
+        if self.worker.as_ref().is_some_and(|w| w.is_finished()) {
+            panic!("proseg-live: the frame writer stopped; see the error above");
+        }
+        if self.counts.as_ref().and_then(|c| c.worker.as_ref()).is_some_and(|w| w.is_finished()) {
+            panic!("proseg-live: the counts writer stopped; see the error above");
+        }
+    }
+
+    /// The control file's counts and where tokens (--live-counts; ignored without it).
+    fn take_tokens(&mut self, control: &Control) {
+        if let Some(counts) = self.counts.as_mut() {
+            counts.asked = control.counts;
+            counts.asked_where = control.where_;
+        }
+    }
+
+    /// Tokens read while paused or held are served by the paused state: a counts token is marked served (its line is
+    /// the state's own), a where token is exported at once from this state (on this thread; the counts writer is idle
+    /// after `settle`).
+    fn serve_held(&mut self, voxels: &VoxelCheckerboard) {
+        let margin = self.where_margin();
+        let seq = self.committed.load(Ordering::Acquire).saturating_sub(1);
+        let iteration = self.last_iteration;
+        let dir = self.dir.clone();
+        let Some(counts) = self.counts.as_mut() else {
+            return;
+        };
+        counts.served = counts.served.max(counts.asked);
+        if let Some(ask) = counts.asked_where.filter(|w| w.token > counts.served_where) {
+            let found = voxels.live_where(ask.bx, margin as f32);
+            let export = WhereExport { meta: where_meta(ask, seq, iteration, margin, &found), found };
+            write_where(&dir, &export, &counts.wheres);
+            counts.served_where = ask.token;
+        }
+    }
+
+    /// The where export's scan margin at the run's diffusion-sigma-far now (µm).
+    fn where_margin(&self) -> f64 {
+        where_margin(self.values.get("diffusion-sigma-far").and_then(Value::as_f64).unwrap_or(0.0))
+    }
+
+    /// Why the frame of `phase` about to be taken is counted: init and upscale always; a pending token while the
+    /// counts writer is idle (request: the frame is then taken whatever thinning or the tiled cadence say); every frame
+    /// taken in "every" mode. None without --live-counts.
+    fn counts_ask(&self, phase: &str) -> Option<Reason> {
+        let counts = self.counts.as_ref()?;
+        match phase {
+            "init" => Some(Reason::Init),
+            "upscale" => Some(Reason::Upscale),
+            _ if counts.pending() && counts.idle() => Some(Reason::Request),
+            _ if counts.options.every => Some(Reason::Every),
+            _ => None,
+        }
+    }
+
+    /// Whether the committed state `seq` is counted (again) for `reason`: once per frame, except that a pause needs the
+    /// count proseg saves there (with f) and a hold, finish or end needs its count durable.
+    fn counts_needed(&self, seq: u64, reason: Reason) -> bool {
+        let Some(counts) = self.counts.as_ref() else {
+            return false;
+        };
+        match counts.last {
+            Some(last) if last.seq == seq => {
+                (reason == Reason::Pause && !last.sampled) || (reason.durable() && !last.durable)
+            }
+            _ => true,
+        }
+    }
+
+    /// Count the state of frame `seq` (taken now: nothing has run since its snapshot) and queue it for the counts
+    /// writer; pending tokens are served by it (a where token only `with_where`: frames taken while sampling). A request
+    /// never waits for the writer: when its queue is full nothing is counted and the tokens stay pending. Returns
+    /// whether the frame was counted.
+    fn count(
+        &mut self,
+        voxels: &VoxelCheckerboard,
+        params: &ModelParams,
+        seq: u64,
+        iteration: usize,
+        reason: Reason,
+        with_where: bool,
+    ) -> bool {
+        let margin = self.where_margin();
+        let (dir, ncells) = (self.dir.clone(), self.ncells);
+        let Some(counts) = self.counts.as_mut() else {
+            return false;
+        };
+        let t0 = Instant::now();
+        if reason == Reason::Init && counts.options.start_every.is_some() && counts.start.is_none() {
+            counts.start = Some(params.live_start_copy());
+        }
+        let first = counts.last.is_none_or(|last| last.seq != seq);
+        let ordinal = counts.ordinal + first as u64;
+        let sampled = reason.forced() || counts.options.every;
+        let with_start = counts.start.is_some()
+            && (reason.forced() || counts.options.start_every.is_some_and(|k| ordinal % k == 0));
+        let found = params.live_gene_counts(
+            sampled,
+            counts.options.unmodeled_fixed_cells,
+            if with_start { counts.start.as_ref() } else { None },
+        );
+        if found.f_outside > 0 {
+            eprintln!("proseg-live: {} sampled transcripts outside the assigned counts at frame {seq}", found.f_outside);
+        }
+        let token = (counts.asked > counts.served).then_some(counts.asked);
+        let place = with_where
+            .then(|| counts.asked_where.filter(|w| w.token > counts.served_where))
+            .flatten()
+            .map(|ask| {
+                let found = voxels.live_where(ask.bx, margin as f32);
+                WhereExport { meta: where_meta(ask, seq, iteration, margin, &found), found }
+            });
+        let extract_ms = t0.elapsed().as_secs_f64() * 1e3;
+        let file = format!("{seq:06}.counts.zst");
+        let (path, name) = match &counts.options.spool {
+            Some(spool) if !reason.durable() => (spool.join(&file), spool.join(&file).to_string_lossy().into_owned()),
+            _ => (dir.join("frames").join(&file), format!("frames/{file}")),
+        };
+        let durable = path.starts_with(dir.join("frames")) && sampled;
+        let where_token = place.as_ref().map(|export| export.meta["token"].as_u64().unwrap());
+        let job = CountsJob {
+            seq,
+            iteration,
+            reason,
+            token,
+            ncells,
+            ngenes: params.ngenes(),
+            counts: found,
+            path,
+            name,
+            place,
+            extract_ms,
+        };
+        let sender = counts.sender.as_ref().expect("proseg-live: counts writer already closed");
+        if reason == Reason::Request {
+            match sender.try_send(job) {
+                Ok(()) => {}
+                Err(TrySendError::Full(_)) => return false,
+                Err(TrySendError::Disconnected(_)) => panic!("proseg-live: the counts writer stopped; see the error above"),
+            }
+        } else {
+            sender.send(job).expect("proseg-live: the counts writer stopped");
+        }
+        counts.queued += 1;
+        counts.served = counts.served.max(token.unwrap_or(0));
+        counts.served_where = counts.served_where.max(where_token.unwrap_or(0));
+        counts.last = Some(Counted { seq, sampled, durable });
+        counts.ordinal = ordinal;
+        true
+    }
+
+    fn take_settings(&mut self, settings: serde_json::Map<String, Value>) {
+        for (flag, value) in settings {
+            let changed = if flag == "temperature" {
+                self.temperature != value.as_f64().map(|v| v as f32)
+            } else {
+                self.values.get(&flag) != Some(&value)
+            };
+            if changed {
+                eprintln!("proseg-live: set {flag} {value}");
+                if flag == "temperature" {
+                    self.temperature = value.as_f64().map(|v| v as f32);
+                }
+                self.values.insert(flag, value);
+            }
+        }
+    }
+
+    /// Proseg's voxel prior (see `live_prior`), written once before the first frame: labels then permille, u32 LE,
+    /// zstd. Returns its geometry for info.json.
+    pub fn write_prior(&self, voxels: &VoxelCheckerboard) -> Value {
+        if self.tiled {
+            let (geometry, labels, permille) = voxels.live_prior_projection();
+            write_container(&self.dir.join("prior.tiles"), geometry.nx, geometry.ny, 1, &["label", "permille"],
+                            &[&labels, &permille], None);
+            return json!({"file": "prior.tiles", "format": "tiles", "tile": TILE, "nx": geometry.nx, "ny": geometry.ny,
+                          "nz": 1, "x0": geometry.x0, "y0": geometry.y0, "voxel": geometry.voxelsize});
+        }
+        let (prior, permille) = voxels.live_prior();
+        let mut bytes: Vec<u8> = Vec::with_capacity((prior.layers.len() + permille.len()) * 4);
+        for &value in prior.layers.iter().chain(permille.iter()) {
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        let packed = zstd::bulk::compress(&bytes, 3).expect("proseg-live: cannot compress the prior");
+        atomic_write(&self.dir.join("prior.bin.zst"), &packed).expect("proseg-live: cannot write the prior");
+        json!({"file": "prior.bin.zst", "nx": prior.nx, "ny": prior.ny, "nz": prior.nlayers,
+               "x0": prior.x0, "y0": prior.y0, "voxel": prior.voxelsize})
+    }
+
+    /// The transcripts exactly as proseg models them (after its quality, gene and distance filters).
+    pub fn write_transcripts(&self, dataset: &TranscriptDataset) {
+        let path = self.dir.join("transcripts.bin.gz");
+        let tmp = self.dir.join(".transcripts.tmp");
+        {
+            let file = File::create(&tmp).expect("proseg-live: cannot write transcripts");
+            let mut gz =
+                GzEncoder::new(BufWriter::with_capacity(1 << 20, file), Compression::new(1));
+            let mut bytes: Vec<u8> = Vec::with_capacity(1 << 20);
+            for run in dataset.transcripts.iter_runs() {
+                let t = run.value;
+                for _ in 0..run.len {
+                    bytes.extend_from_slice(&t.x.to_le_bytes());
+                    bytes.extend_from_slice(&t.y.to_le_bytes());
+                    bytes.extend_from_slice(&t.z.to_le_bytes());
+                    bytes.extend_from_slice(&t.gene.to_le_bytes());
+                }
+                if bytes.len() >= 1 << 20 {
+                    gz.write_all(&bytes)
+                        .expect("proseg-live: cannot write transcripts");
+                    bytes.clear();
+                }
+            }
+            gz.write_all(&bytes)
+                .expect("proseg-live: cannot write transcripts");
+            gz.finish()
+                .and_then(|mut w| w.flush())
+                .expect("proseg-live: cannot write transcripts");
+        }
+        fs::rename(&tmp, &path).expect("proseg-live: cannot publish transcripts");
+        let mut names = dataset.gene_names.join("\n");
+        names.push('\n');
+        atomic_write(&self.dir.join("genes.txt"), names.as_bytes())
+            .expect("proseg-live: cannot write genes.txt");
+    }
+
+    /// After a completed iteration (or event): publish a snapshot, unless history thinning skips this iteration.
+    pub fn frame(
+        &mut self,
+        voxels: &VoxelCheckerboard,
+        params: &ModelParams,
+        phase: &str,
+        iteration: usize,
+        temperature: f32,
+        stats: &IterationStats,
+        nonempty_cells: usize,
+    ) {
+        self.check_writer();
+        self.last_iteration = iteration;
+        let counted = self.counts_ask(phase);
+        let requested = counted == Some(Reason::Request);
+        if requested
+            || is_kept(phase, iteration) && (!self.tiled || matches!(phase, "init" | "upscale") || self.cadence_allows())
+        {
+            self.pending = None;
+            self.emit(voxels, params, phase, iteration, temperature, stats, nonempty_cells, counted, true);
+        } else {
+            self.pending = Some(Pending {
+                phase: phase.to_owned(),
+                iteration,
+                temperature,
+                stats: *stats,
+                nonempty_cells,
+            });
+        }
+    }
+
+    /// Snapshot the current segmentation and hand it to the writer thread; then, when `counted` says why, its counts
+    /// to the counts writer (`count`; a pending where token too with `with_where`).
+    #[allow(clippy::too_many_arguments)]
+    fn emit(
+        &mut self,
+        voxels: &VoxelCheckerboard,
+        params: &ModelParams,
+        phase: &str,
+        iteration: usize,
+        temperature: f32,
+        stats: &IterationStats,
+        nonempty_cells: usize,
+        counted: Option<Reason>,
+        with_where: bool,
+    ) {
+        let seq = self.seq;
+        self.emit_frame(voxels, params, phase, iteration, temperature, stats, nonempty_cells);
+        if let Some(reason) = counted {
+            self.count(voxels, params, seq, iteration, reason, with_where);
+        }
+    }
+
+    /// The frame itself (frames.jsonl and the frame files, as without --live-counts).
+    #[allow(clippy::too_many_arguments)]
+    fn emit_frame(
+        &mut self,
+        voxels: &VoxelCheckerboard,
+        params: &ModelParams,
+        phase: &str,
+        iteration: usize,
+        temperature: f32,
+        stats: &IterationStats,
+        nonempty_cells: usize,
+    ) {
+        // Refinement does not perform a sampler iteration, so retain its last temperature.
+        let temperature = if phase == "upscale" {
+            self.values
+                .get("temperature")
+                .and_then(Value::as_f64)
+                .unwrap_or(temperature as f64) as f32
+        } else {
+            temperature
+        };
+        self.values.insert("temperature".into(), json!(temperature));
+        if self.tiled {
+            self.emit_tiled(voxels, params, phase, iteration, temperature, stats, nonempty_cells);
+            return;
+        }
+        let t0 = Instant::now();
+        let raster = voxels.live_raster();
+        let (changed, changed_cells) = self.tracker.track(
+            raster.nx,
+            raster.ny,
+            raster.i0,
+            raster.j0,
+            raster.voxelsize,
+            &raster.consensus,
+            iteration as u32,
+        );
+        let (assigned, foreground) = params.live_cell_counts();
+        let geometry = (raster.nx, raster.ny, raster.nlayers, raster.x0, raster.y0, raster.voxelsize);
+        let mut seen = vec![false; self.ncells + 1];
+        for &label in &raster.consensus {
+            seen[label as usize] = true;
+        }
+        let visible = seen.iter().skip(1).filter(|s| **s).count();
+        let mut payload =
+            Vec::with_capacity(raster.consensus.len() * 2 + raster.layers.len());
+        payload.extend_from_slice(&raster.consensus);
+        payload.extend_from_slice(&self.tracker.last_change);
+        payload.extend_from_slice(&raster.layers);
+        let ms_extract = t0.elapsed().as_secs_f64() * 1e3;
+
+        let record = json!({
+            "seq": self.seq,
+            "iter": iteration,
+            "phase": phase,
+            "file": null,
+            "nx": raster.nx,
+            "ny": raster.ny,
+            "nz": raster.nlayers,
+            "x0": raster.x0,
+            "y0": raster.y0,
+            "voxel": raster.voxelsize,
+            "temperature": temperature,
+            "live": ({ let mut v = self.values.clone(); v.insert("temperature".into(), json!(temperature)); v }),
+            "loglik": finite(stats.loglik),
+            "assigned": stats.nassigned,
+            "foreground": stats.nforeground,
+            "transcripts": self.ntranscripts,
+            "cells": nonempty_cells,
+            "visible": visible,
+            "changed": changed,
+            "t": self.started.elapsed().as_secs_f64(),
+            "ms": {
+                "morphology": stats.ms_morphology,
+                "repositioning": stats.ms_repositioning,
+                "parameters": stats.ms_parameters,
+                "extract": ms_extract,
+                "write": null,
+            },
+        });
+        self.sender
+            .as_ref()
+            .expect("proseg-live: frame writer already closed")
+            .send(Job::Dense(FrameJob {
+                seq: self.seq,
+                payload,
+                record,
+                ncells: self.ncells,
+                geometry,
+                assigned,
+                foreground,
+                changed: changed_cells,
+            }))
+            .expect("proseg-live: the frame writer stopped");
+        self.tracker.remember(raster.nx, raster.ny, raster.i0, raster.j0, raster.voxelsize, raster.consensus);
+        self.seq += 1;
+    }
+
+    /// Whether a tiled snapshot fits the time budget now (its extraction last took `last_extract_ms`), and the writer
+    /// has at most one frame in flight.
+    fn cadence_allows(&self) -> bool {
+        let in_flight = self.seq.saturating_sub(self.committed.load(Ordering::Acquire));
+        in_flight <= 1 && self.last_emit.elapsed().as_secs_f64() * 1e3 * TILED_BUDGET >= self.last_extract_ms
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn emit_tiled(
+        &mut self,
+        voxels: &VoxelCheckerboard,
+        params: &ModelParams,
+        phase: &str,
+        iteration: usize,
+        temperature: f32,
+        stats: &IterationStats,
+        nonempty_cells: usize,
+    ) {
+        let t0 = Instant::now();
+        let snap = voxels.live_tiled(self.view, WINDOW_MAX, self.ncells);
+        let (assigned, foreground) = params.live_cell_counts();
+        let ms_extract = t0.elapsed().as_secs_f64() * 1e3;
+        let window = snap.window.as_ref().map(|w| json!({"i0": w.i0, "j0": w.j0, "nx": w.nx, "ny": w.ny}));
+        let record = json!({
+            "seq": self.seq,
+            "iter": iteration,
+            "phase": phase,
+            "file": null,
+            "format": "tiles",
+            "tile": TILE,
+            "window": window,
+            "view": self.view,
+            "nx": snap.nx,
+            "ny": snap.ny,
+            "nz": snap.nlayers,
+            "x0": snap.x0,
+            "y0": snap.y0,
+            "voxel": snap.voxelsize,
+            "temperature": temperature,
+            "live": ({ let mut v = self.values.clone(); v.insert("temperature".into(), json!(temperature)); v }),
+            "loglik": finite(stats.loglik),
+            "assigned": stats.nassigned,
+            "foreground": stats.nforeground,
+            "transcripts": self.ntranscripts,
+            "cells": nonempty_cells,
+            "visible": null,
+            "changed": null,
+            "t": self.started.elapsed().as_secs_f64(),
+            "ms": {
+                "morphology": stats.ms_morphology,
+                "repositioning": stats.ms_repositioning,
+                "parameters": stats.ms_parameters,
+                "extract": ms_extract,
+                "write": null,
+            },
+        });
+        self.sender
+            .as_ref()
+            .expect("proseg-live: frame writer already closed")
+            .send(Job::Tiled(TiledJob {
+                seq: self.seq,
+                record,
+                snap,
+                ncells: self.ncells,
+                assigned,
+                foreground,
+                iteration: iteration as u32,
+            }))
+            .expect("proseg-live: the frame writer stopped");
+        self.window_view = self.view;
+        self.last_emit = Instant::now();
+        self.last_extract_ms = ms_extract;
+        self.seq += 1;
+    }
+
+    /// While paused, a view that moved gets the per-layer labels of the paused state (window.json + window-N.bin.zst).
+    fn refresh_window(&mut self, voxels: &VoxelCheckerboard) {
+        let Some(view) = self.view else {
+            return;
+        };
+        if self.window_view == Some(view) {
+            return;
+        }
+        self.window_view = Some(view);
+        let Some((geometry, window)): Option<(LiveTiled, LiveWindow)> = voxels.live_window(view, WINDOW_MAX) else {
+            return;
+        };
+        self.windows += 1;
+        let name = format!("window-{}.bin.zst", self.windows);
+        let packed = zstd::bulk::compress(&le_bytes(&window.layers), 1).expect("proseg-live: cannot compress the window");
+        atomic_write(&self.dir.join(&name), &packed).expect("proseg-live: cannot write the window");
+        let description = json!({
+            "seq": self.committed.load(Ordering::Acquire) as i64 - 1, "iter": self.last_iteration,
+            "i0": window.i0, "j0": window.j0, "nx": window.nx, "ny": window.ny, "nz": geometry.nlayers,
+            "raster_nx": geometry.nx, "raster_ny": geometry.ny, "x0": geometry.x0, "y0": geometry.y0,
+            "voxel": geometry.voxelsize, "file": name, "view": view,
+        });
+        atomic_write(&self.dir.join("window.json"), &serde_json::to_vec(&description).unwrap())
+            .expect("proseg-live: cannot write window.json");
+        if self.windows > 2 {
+            let _ = fs::remove_file(self.dir.join(format!("window-{}.bin.zst", self.windows - 2)));
+        }
+    }
+
+    /// Emit the final state if it was thinned out (with --live-counts, count it as the end unless a finish counted it
+    /// already), flush every queued frame and counts line, then mark sampling as finished (proseg writes its outputs
+    /// next).
+    pub fn sampling_done(&mut self, voxels: &VoxelCheckerboard, params: &ModelParams) {
+        if let Some(p) = self.pending.take() {
+            let counted = self.counts.is_some().then_some(Reason::End);
+            self.emit(voxels, params, &p.phase, p.iteration, p.temperature, &p.stats, p.nonempty_cells, counted, false);
+        } else if self.seq > 0 && self.counts_needed(self.seq - 1, Reason::End) {
+            self.count(voxels, params, self.seq - 1, self.last_iteration, Reason::End, false);
+        }
+        drop(self.sender.take());
+        if let Some(worker) = self.worker.take() {
+            worker.join().expect("proseg-live: the frame writer failed");
+        }
+        if let Some(counts) = self.counts.as_mut() {
+            drop(counts.sender.take());
+            if let Some(worker) = counts.worker.take() {
+                worker.join().expect("proseg-live: the counts writer failed");
+            }
+        }
+        let _ = fs::write(
+            self.dir.join("sampling_done"),
+            format!("{}\n", self.started.elapsed().as_secs_f64()),
+        );
+    }
+}
+
+// Bounds also limit table sizes and avoid degenerate probability distributions.
+fn parse_setting(flag: &str, raw: &str) -> Option<Value> {
+    if matches!(flag, "no-diffusion" | "enforce-connectivity") {
+        return match raw {
+            "true" | "1" => Some(json!(true)),
+            "false" | "0" => Some(json!(false)),
+            _ => None,
+        };
+    }
+    let (lo, hi) = match flag {
+        "temperature" => (0.01, 1.0),
+        "morphology-steps-per-iter" => {
+            return raw
+                .parse::<u64>()
+                .ok()
+                .map(|v| json!(v.clamp(1, 1_000_000)));
+        }
+        "cell-compactness" => (0.001, 10.0),
+        "prior-weight" => (0.0, 1000.0),
+        "diffusion-probability" | "ab-nihlo-bubble-prob" => (0.0, 1.0),
+        "diffusion-sigma-near" | "diffusion-sigma-far" | "diffusion-proposal-sigma" => {
+            (0.01, 100.0)
+        }
+        "diffusion-sigma-z" | "diffusion-proposal-sigma-z" => (0.001, 2.0),
+        "dispersion" => (0.001, 1000.0),
+        _ => return None,
+    };
+    let value = raw.parse::<f64>().ok()?;
+    value.is_finite().then(|| json!(value.clamp(lo, hi)))
+}
