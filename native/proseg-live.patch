+    #[test]
+    fn a_pause_on_a_frame_a_token_counted_counts_it_again_with_f() {
+        // The page pauses a run on a frame its token counted (a request: in the spool, without f). Made certain here by
+        // a step and a token written together while paused: the step's frame is the token's, and the wait after it
+        // pauses there. The pause counts that state again from the same snapshot, into the same file, with f (what a
+        // finish there saves) and the start block, before its ack, and only once.
+        let dir = scratch("pause-on-token");
+        let spool = dir.join("spool");
+        let mut model = Model::new();
+        let mut writer = counted_writer(&dir, false, &model, options(Some(&spool), false, Some(4)));
+        model.frame(&mut writer, "init", 0);
+        model.step();
+        model.frame(&mut writer, "sampling", 1);
+        writer.drain();
+        let control = dir.join("control");
+        fs::write(&control, "paused 1\nstep 0\n").unwrap();
+        let stepper = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let paused = until(|| {
+                    read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == 1)
+                });
+                let _ = fs::write(&control, "paused 1\nstep 1\ncounts 1\n");
+                paused
+            })
+        };
+        assert!(writer.wait(&model.voxels, &model.params));
+        assert!(stepper.join().unwrap(), "no paused ack at seq 1");
+        model.step();
+        model.frame(&mut writer, "sampling", 2);
+        writer.drain();
+        // The step's frame, counted for its token (the 3rd counted frame: no start block with K = 4).
+        let all = lines(&dir);
+        assert_eq!(all.len(), 3, "init, the first pause's count, the token's: {all:?}");
+        let request = &all[2];
+        assert_eq!((request["seq"].as_u64(), request["reason"].as_str(), request["token"].as_u64()),
+                   (Some(2), Some("request"), Some(1)));
+        let spooled = std::path::absolute(spool.join("000002.counts.zst")).unwrap();
+        assert_eq!(request["file"], json!(spooled.to_str().unwrap()));
+        assert_eq!((request["has_f"].as_bool(), request["has_start"].as_bool()), (Some(false), Some(false)));
+        let asked = check_counts(&dir, request, &model);
+
+        // The next wait pauses there: the pause's count of seq 2 is kept back on its way to the counts writer, and no
+        // paused ack comes while its line is unwritten.
+        let gate = Gate::install(&mut writer);
+        gate.hold();
+        let watcher = {
+            let (dir, control) = (dir.clone(), control.clone());
+            std::thread::spawn(move || {
+                let mut problems: Vec<String> = Vec::new();
+                let held = gate.held();
+                if held != Some((2, Reason::Pause)) {
+                    problems.push(format!("kept back {held:?}, not the pause's count of seq 2"));
+                }
+                let acked = || read_json(&dir.join("ack")).is_some_and(|a| a["state"] == "paused" && a["seq"] == 2);
+                if seen(Duration::from_millis(300), acked) || lines(&dir).len() != 3 {
+                    problems.push(format!("while the pause's count was unwritten: ack {:?}, lines {:?}",
+                                          read_json(&dir.join("ack")), lines(&dir)));
+                }
+                gate.release();
+                if !until(acked) || lines(&dir).len() != 4 {
+                    problems.push(format!("at the paused ack: ack {:?}, lines {:?}", read_json(&dir.join("ack")),
+                                          lines(&dir)));
+                }
+                // Ten more paused reads: the state is not counted a third time.
+                sleep(Duration::from_millis(400));
+                if lines(&dir).len() != 4 {
+                    problems.push(format!("counted again while paused: {:?}", lines(&dir)));
+                }
+                let _ = fs::write(&control, "paused 0\nstep 1\ncounts 1\n");
+                problems
+            })
+        };
+        assert!(writer.wait(&model.voxels, &model.params));
+        let problems = watcher.join().unwrap();
+        assert!(problems.is_empty(), "{problems:?}");
+        let all = lines(&dir);
+        let pause = &all[3];
+        assert_eq!((pause["seq"].as_u64(), pause["iter"].as_u64(), pause["reason"].as_str(), pause["token"].clone()),
+                   (Some(2), Some(2), Some("pause"), Value::Null));
+        assert_eq!(pause["file"], request["file"], "the token's file, replaced");
+        assert_eq!((pause["has_f"].as_bool(), pause["has_start"].as_bool()), (Some(true), Some(true)));
+        let again = check_counts(&dir, pause, &model);
+        assert_eq!((&again.genes, &again.n, &again.e), (&asked.genes, &asked.n, &asked.e), "the same snapshot");
+        let init = read_plc1(&dir.join("frames/000000.counts.zst"));
