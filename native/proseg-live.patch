+    /// Read a tile container back: (header, planes as full rasters, window blob).
+    fn read_container(path: &Path) -> (Value, Vec<Vec<u32>>, Vec<u32>) {
+        let bytes = fs::read(path).unwrap();
+        assert_eq!(&bytes[..4], b"PLT1");
+        let size = u32::from_le_bytes(bytes[4..8].try_into().unwrap()) as usize;
+        let header: Value = serde_json::from_slice(&bytes[8..8 + size]).unwrap();
+        let (nx, ny) = (header["nx"].as_u64().unwrap() as usize, header["ny"].as_u64().unwrap() as usize);
+        let (tx, ty) = (header["tiles_x"].as_u64().unwrap() as usize, header["tiles_y"].as_u64().unwrap() as usize);
+        let nplanes = header["planes"].as_array().unwrap().len();
+        let entry = |e: usize| -> Vec<u32> {
+            let at = 8 + size + e * 12;
+            let offset = u64::from_le_bytes(bytes[at..at + 8].try_into().unwrap()) as usize;
+            let length = u32::from_le_bytes(bytes[at + 8..at + 12].try_into().unwrap()) as usize;
+            if length == 0 {
+                return Vec::new();
+            }
+            let raw = zstd::bulk::decompress(&bytes[offset..offset + length], 1 << 28).unwrap();
+            raw.chunks(4).map(|c| u32::from_le_bytes(c.try_into().unwrap())).collect()
+        };
+        let mut planes = vec![vec![0u32; nx * ny]; nplanes];
+        for y in 0..ty {
+            for x in 0..tx {
+                for (p, plane) in planes.iter_mut().enumerate() {
+                    let tile = entry((y * tx + x) * nplanes + p);
+                    let w = TILE.min(nx - x * TILE);
+                    for (row, values) in tile.chunks(w).enumerate() {
+                        let dst = (y * TILE + row) * nx + x * TILE;
+                        plane[dst..dst + w].copy_from_slice(values);
+                    }
+                }
+            }
+        }
+        let window = entry(tx * ty * nplanes);
+        (header, planes, window)
+    }
+
+    #[test]
+    fn tile_containers_round_trip_with_edge_and_empty_tiles() {
+        let dir = std::env::temp_dir().join(format!("proseg-live-test-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let (nx, ny) = (TILE * 2 + 7, TILE + 3);
+        let mut first: Vec<u32> = (0..nx * ny).map(|p| (p as u32).wrapping_mul(2654435761) % 97).collect();
+        for y in 0..TILE {
+            first[y * nx..y * nx + TILE].fill(0); // an all-zero tile
+        }
+        let second: Vec<u32> = (0..nx * ny).map(|p| (p % 5) as u32).collect();
+        let layers: Vec<u32> = (0..2 * 3 * 4).collect();
+        let path = dir.join("f.tiles");
+        write_container(&path, nx, ny, 2, &["consensus", "last_change"], &[&first, &second],
+                        Some((json!({"i0": 1, "j0": 2, "nx": 4, "ny": 3, "nz": 2}), &layers)));
+        let (header, planes, window) = read_container(&path);
+        assert_eq!(header["tiles_x"], json!(3));
+        assert_eq!(header["tiles_y"], json!(2));
+        assert_eq!(header["window"]["nx"], json!(4));
+        assert_eq!(planes[0], first);
+        assert_eq!(planes[1], second);
+        assert_eq!(window, layers);
+        fs::remove_dir_all(&dir).unwrap();
+    }
