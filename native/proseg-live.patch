+        check_counts(&dir, &all[2], &model);
+        let left: Vec<String> = fs::read_dir(&spool).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();
+        assert!(left.iter().all(|n| !n.ends_with(".tmp")), "no part left in the spool: {left:?}");
+        writer.sampling_done(&model.voxels, &model.params);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn without_live_counts_tokens_are_ignored_and_nothing_is_counted() {
+        let dir = scratch("off");
+        fs::create_dir_all(dir.join("frames")).unwrap();
+        for stale in ["counts.jsonl", "where.json", "where-3.bin.zst", "window.json"] {
+            fs::write(dir.join(stale), "earlier run").unwrap();
+        }
+        let mut model = Model::new();
+        let control = dir.join("control");
+        let mut writer = LiveWriter::new(dir.to_str().unwrap(), control.to_str(), NTRANSCRIPTS, model.voxels.ncells, false);
+        for stale in ["counts.jsonl", "where.json", "where-3.bin.zst", "window.json"] {
+            assert!(!dir.join(stale).exists(), "{stale} of an earlier run is removed");
+        }
+        writer.write_info(json!({"cells": 9}), &[]);
+        assert!(read_json(&dir.join("info.json")).unwrap().get("counts").is_none());
+        model.frame(&mut writer, "init", 0);
+        fs::write(&control, "counts 1\nwhere 1 0 0 30 30\n").unwrap();
+        assert!(writer.wait(&model.voxels, &model.params));
+        model.step();
+        model.frame(&mut writer, "sampling", 2_001);
+        assert_eq!((writer.seq, writer.pending.is_some()), (1, true), "a token forces no frame");
+        writer.sampling_done(&model.voxels, &model.params);
+        let names: Vec<String> = fs::read_dir(&dir).unwrap().chain(fs::read_dir(dir.join("frames")).unwrap())
+            .map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();
+        assert!(names.iter().all(|n| !n.contains("counts") && !n.contains("counted") && !n.starts_with("where")), "{names:?}");
+        fs::remove_dir_all(&dir).unwrap();
+    }
+}
