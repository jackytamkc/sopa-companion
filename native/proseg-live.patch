+/// Cells that still own at least one voxel (initialised cells never gain or lose identity).
+fn nonempty_cells(params: &ModelParams) -> usize {
+    params.cell_voxel_count.iter().filter(|n| *n > 0).count()
+}
+
+/// Apply only between sampler calls; diffusion caches are rebuilt together before use.
+fn apply_live(
+    writer: &LiveWriter,
+    priors: &mut ModelPriors,
+    sampler: &mut VoxelSampler,
+    repo: &mut TranscriptRepo,
+    voxels: &VoxelCheckerboard,
+    prior_scale: f32,
+    steps: &mut usize,
+) {
+    let old = *priors;
+    for (flag, value) in &writer.values {
+        let f = value.as_f64().unwrap_or(0.0) as f32;
+        match flag.as_str() {
+            "morphology-steps-per-iter" => *steps = value.as_u64().unwrap() as usize,
+            "cell-compactness" => priors.σ_iiq = f,
+            "prior-weight" => priors.prior_weight = f * prior_scale,
+            "no-diffusion" => priors.use_diffusion_model = !value.as_bool().unwrap(),
+            "enforce-connectivity" => priors.enforce_connectivity = value.as_bool().unwrap(),
+            "diffusion-probability" => priors.p_diffusion = f,
+            "diffusion-sigma-near" => priors.σ_xy_diffusion_near = f,
+            "diffusion-sigma-far" => priors.σ_xy_diffusion_far = f,
+            "diffusion-sigma-z" => priors.σ_z_diffusion = f,
+            "diffusion-proposal-sigma" => priors.σ_xy_diffusion_proposal = f,
+            "diffusion-proposal-sigma-z" => priors.σ_z_diffusion_proposal = f,
+            "ab-nihlo-bubble-prob" => sampler.bubble_formation_prob = f,
+            "dispersion" if !value.is_null() => priors.dispersion = Some(f),
+            _ => {}
+        }
+    }
+    if old.σ_xy_diffusion_near != priors.σ_xy_diffusion_near
+        || old.σ_xy_diffusion_far != priors.σ_xy_diffusion_far
+        || old.σ_z_diffusion != priors.σ_z_diffusion
+        || old.σ_xy_diffusion_proposal != priors.σ_xy_diffusion_proposal
+        || old.σ_z_diffusion_proposal != priors.σ_z_diffusion_proposal
+    {
+        repo.set_voxel_size(priors, voxels.voxelsize, voxels.voxelsize_z);
+    }
+}
