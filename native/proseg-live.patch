+    #[test]
+    fn change_tracking_carries_across_a_resolution_increase() {
+        let mut tracker = ChangeTracker::new(3);
+        let coarse = vec![1, 1, 2, 0];
+        assert_eq!(tracker.track(2, 2, 0, 0, 2.0, &coarse, 1).0, 0);
+        tracker.remember(2, 2, 0, 0, 2.0, coarse);
+        let (changed, per_cell) = tracker.track(2, 2, 0, 0, 2.0, &[1, 2, 2, 0], 5);
+        assert_eq!((changed, per_cell), (1, vec![0, 1, 1, 0]));
+        assert_eq!(tracker.last_change, vec![0, 5, 0, 0]);
+        tracker.remember(2, 2, 0, 0, 2.0, vec![1, 2, 2, 0]);
+        // 2 um -> 1 um: every old column becomes a 2 x 2 block; one fine column differs from its block.
+        let mut fine = vec![1, 1, 2, 2, 1, 1, 2, 2, 2, 2, 0, 0, 2, 2, 0, 3];
+        let (changed, per_cell) = tracker.track(4, 4, 0, 0, 1.0, &fine, 6);
+        assert_eq!(changed, 1);
+        assert_eq!(per_cell[3], 1);
+        assert_eq!(&tracker.last_change[..4], &[0, 0, 5, 5]);
+        assert_eq!(tracker.last_change[15], 6);
+        fine[0] = 2;
+        tracker.remember(4, 4, 0, 0, 1.0, vec![1, 1, 2, 2, 1, 1, 2, 2, 2, 2, 0, 0, 2, 2, 0, 3]);
+        assert_eq!(tracker.track(4, 4, 0, 0, 1.0, &fine, 7).0, 1);
+    }
