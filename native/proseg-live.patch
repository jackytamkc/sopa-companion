+    #[test]
+    fn plc1_files_round_trip_with_and_without_f_and_the_start_block() {
+        let dir = scratch("plc1");
+        // Three cells: genes 1, 4, 9 / none / 0, 9; one value clipped where it was taken (`saturated`).
+        let base = LiveGeneCounts {
+            indptr: vec![0, 3, 3, 5],
+            genes: vec![1, 4, 9, 0, 9],
+            n: vec![1, 65_535, 3, 2, 5],
+            e: vec![20, 65_535, 0, 64, 133],
+            f: None,
+            start: None,
+            saturated: 2,
+            f_outside: 0,
+        };
+        let cases = [
+            (10, None, None),
+            (10, Some(vec![1, 60_000, 0, 2, 4]), None),
+            (10, Some(vec![0, 1, 2, 0, 5]), Some(vec![32, 7, 0, 99])),
+            (70_000, None, Some(vec![1])),
+        ];
+        for (k, (ngenes, f, start)) in cases.into_iter().enumerate() {
+            let mut counts = LiveGeneCounts { f: f.clone(), start: start.clone(), ..base.clone() };
+            if ngenes > 65_535 {
+                counts.genes = vec![1, 65_536, 69_999, 0, 69_999];
+            }
+            let path = dir.join(format!("{k}.counts.zst"));
+            fs::write(&path, zstd::bulk::compress(&plc1(3, ngenes, 450, &counts), 1).unwrap()).unwrap();
+            let read = read_plc1(&path);
+            assert_eq!((read.ncells, read.ngenes, read.iteration, read.saturated), (3, ngenes, 450, 2));
+            assert_eq!(read.flags, f.is_some() as u32 | ((ngenes > 65_535) as u32) << 1 | (start.is_some() as u32) << 2);
+            assert_eq!((read.indptr, read.genes), (counts.indptr.clone(), counts.genes.clone()));
+            assert_eq!((read.n, read.e, read.f, read.start), (counts.n.clone(), counts.e.clone(), f, start));
+            // The sidecar: per cell, its stored e summed / 32, as f32.
+            assert_eq!(
+                counted_bytes(&counts),
+                [(20.0 + 65_535.0 + 0.0) / 32.0, 0.0, (64.0 + 133.0) / 32.0]
+                    .iter()
+                    .flat_map(|&v: &f64| (v as f32).to_le_bytes())
+                    .collect::<Vec<u8>>()
+            );
+        }
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    /// Per cell, per gene ascending: the sum over the cell's `entries` (gene, layer, density, count) of count x p, in
+    /// f64, recomputed from the model's parameters as the background split defines p (paramsampler.rs), not with
+    /// `live_gene_counts`: p = λ_cg / (λ_cg + `background`(gene, layer, density)), λ_cg = φ_c[g] for an unfactored gene,
+    /// else φ_c · θ_g over the factored dimensions; p = 1 on the rows `whole` says.
+    fn averaged(
+        params: &ModelParams,
+        nunfactored: usize,
+        entries: &[Vec<(u32, u32, u8, u32)>],
+        background: impl Fn(usize, usize, usize) -> f64,
+        whole: impl Fn(usize) -> bool,
+    ) -> Vec<Vec<(u32, f64)>> {
+        let (φ, θ) = (&params.φ, &params.θ);
+        let rate = |c: usize, g: usize| -> f64 {
+            if g < nunfactored {
+                φ[[c, g]] as f64
+            } else {
+                (nunfactored..φ.ncols()).map(|k| φ[[c, k]] as f64 * θ[[g, k]] as f64).sum()
+            }
+        };
+        let mut rows = Vec::with_capacity(entries.len());
+        for (c, row) in entries.iter().enumerate() {
+            let mut sums: Vec<(u32, f64)> = Vec::new();
+            for &(g, layer, density, count) in row {
+                let λ = rate(c, g as usize);
+                let p = if whole(c) { 1.0 } else { λ / (λ + background(g as usize, layer as usize, density as usize)) };
+                match sums.last_mut() {
+                    Some((gene, sum)) if *gene == g => *sum += count as f64 * p,
+                    _ => sums.push((g, count as f64 * p)),
+                }
+            }
+            rows.push(sums);
+        }
+        rows
+    }
+
+    /// Stored values (x 32) against their recomputation, row by row and gene by gene: within the rounding (and f32's).
+    fn matches(indptr: &[u32], genes: &[u32], stored: &[u16], expected: &[Vec<(u32, f64)>]) -> Result<(), String> {
+        for (c, row) in expected.iter().enumerate() {
+            let at = indptr[c] as usize..indptr[c + 1] as usize;
+            if genes[at.clone()].iter().copied().ne(row.iter().map(|&(g, _)| g)) {
+                return Err(format!("cell {c}: genes {:?}, recomputed {row:?}", &genes[at]));
+            }
+            for (k, &(g, value)) in at.zip(row) {
+                if (stored[k] as f64 - 32.0 * value).abs() > 0.51 {
+                    return Err(format!("cell {c} gene {g}: stored {} / 32, recomputed {value}", stored[k]));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// The pattern of `rows` (CSR indptr and genes).
+    fn pattern(rows: &[Vec<(u32, f64)>]) -> (Vec<u32>, Vec<u32>) {
+        let mut indptr = vec![0u32];
+        let mut genes = Vec::new();
+        for row in rows {
+            genes.extend(row.iter().map(|&(g, _)| g));
+            indptr.push(genes.len() as u32);
+        }
+        (indptr, genes)
+    }
